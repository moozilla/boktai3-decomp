-        m = re.match(r"movs r0, #(0x[0-9a-f]+|\d+)$", s)
-        if m:
-            r0 = int(m.group(1), 0)
-            continue
-        m = re.match(r"ldr r0, \S+ @ =(0x[0-9A-Fa-f]+)$", s)
-        if m:
-            r0 = int(m.group(1), 16)

-        else:
-            samples.append({"addr": f"{a:08X}", "size": e - a, "wave": True})
-    return {"songs": songs, "players": {str(k): v for k, v in pl.items()}, "voicegroups": vgs, "samples": samples,
-            "table": {"addr": f"{m4a.SONG_TABLE:08X}", "size": 8 * len(w.songs)}}

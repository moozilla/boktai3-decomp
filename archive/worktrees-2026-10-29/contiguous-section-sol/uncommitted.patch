diff --git a/include/actor_attachment_playback.h b/include/actor_attachment_playback.h
new file mode 100644
index 000000000..1b58c9a83
--- /dev/null
+++ b/include/actor_attachment_playback.h
@@ -0,0 +1,95 @@
+#ifndef GUARD_ACTOR_ATTACHMENT_PLAYBACK_H
+#define GUARD_ACTOR_ATTACHMENT_PLAYBACK_H
+#include "actor_attachment_state.h"
+static inline void ActorAttachment_StepPart(struct ActorAttachmentPartSprite *sprite,
+    struct DisplaySequenceState *state, const struct ActorAttachmentPartResource *resource)
+{
+    const volatile u16 *command = state->commands + state->index;
+    u32 duration, flags;
+    {
+        u32 frame = *command >> 6;
+        register u32 width asm("r1") = sprite->width >> 3;
+        u32 height = sprite->height >> 3;
+        height *= width;
+        height *= frame;
+        height += resource->tileBase;
+        sprite->tile = height;
+    }
+    {
+        u32 input = state->flags;
+        u32 bit = 1;
+        register u32 first asm("r1");
+        asm("" : "+r"(bit));
+        first = bit;
+        first &= input;
+        if (first != (((*command & 0x30) >> 4) & bit))
+            sprite->flags |= 4;
+        else
+            sprite->flags &= ~4;
+    }
+    {
+        u32 input = state->flags;
+        u32 bit = 2;
+        register u32 first asm("r1");
+        asm("" : "+r"(bit));
+        first = bit;
+        first &= input;
+        asm("" : "+r"(first));
+        first = (u8)first;
+        if (first != (((*command & 0x30) >> 4) & bit))
+            sprite->flags |= 8;
+        else
+            sprite->flags &= ~8;
+    }
+    {
+        u32 elapsed = state->elapsed + 1;
+        u32 mask;
+        register u32 temp asm("r1");
+        register u32 cache asm("r3");
+        state->elapsed = elapsed;
+        temp = 0xFFFF;
+        asm("" : "+r"(temp));
+        mask = temp;
+        asm("" : "+&r"(mask) : "r"(temp));
+        duration = state->duration;
+        elapsed = (u16)elapsed;
+        cache = duration;
+        asm("" : : "r"(cache));
+        if ((u16)elapsed >= duration) {
+            state->elapsed = 0;
+            flags = state->flags;
+            if (flags & 4) {
+                u32 index = state->index;
+                if (!index) {
+                    u32 hold = 8;
+                    hold &= flags;
+                    asm("" : "+r"(hold));
+                    if (hold)
+                        state->elapsed = cache;
+                    else
+                        state->index = state->frameCount - 1;
+                } else
+                    state->index = index - 1;
+            } else {
+                u32 index = state->index + 1;
+                state->index = index;
+                cache = state->frameCount;
+                asm("" : : "r"(cache));
+                if ((index & mask) >= cache) {
+                    u32 endFlag = flags & 8;
+                    asm("" : "+r"(endFlag));
+                    endFlag = (u8)endFlag;
+                    if (endFlag) {
+                        state->elapsed = duration;
+                        state->index = cache - 1;
+                    } else
+                        state->index = 0;
+                }
+            }
+            asm("" : : "r"(cache));
+            command = state->commands + state->index;
+            state->duration = ((*command & 15) * (s32)state->speed) >> 6;
+        }
+    }
+}
+#endif

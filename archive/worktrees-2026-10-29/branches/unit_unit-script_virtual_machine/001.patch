+            if (!op)
+                return ((struct Slot *)((u32)slot + 8))->value;
+            if (op == 0x16) {
+                struct Slot *saved;
+                u8 *reference = slot->reference;
+                u32 type = *reference;
+                u32 category = type & 0xF0;
+                saved = slot;
+                if (category == 0x90)
+                    Script_SetStackArgument(type & 15, ((struct Slot *)((u32)slot + 8))->value);
+                else

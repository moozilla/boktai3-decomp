+static inline void Fill(s32 *p, s32 v, s32 n)
+{
+    s32 *q = p + n - 1;
+    do {
+        *q = v;
+        q--;
+    } while ((s32)q >= (s32)p);
+}
+
+s32 Modifier_EnumerateSelection(struct ModifierSelection *p, s32 *out)
+{
+    s32 *w;
+    s32 n, i;
+    Fill(out, -1, 16);
+    n = 0;
+    for (i = 0, w = out; i <= 23; i++) {
+        if (Modifier_TestSelection(p, i) && n <= p->count) {
+            *w++ = i;
+            n++;
+        }
+    }
+    return n;
+}

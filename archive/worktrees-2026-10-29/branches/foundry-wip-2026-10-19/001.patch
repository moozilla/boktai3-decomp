+        Palette_BlendBank(dest, source, 0x10, c->timer, 3);
+        off = c->bank * 32;
+        source = (u8 *)c + (off + 0x48);
+        dest = (u8 *)c + (off + 0x248);
+        Palette_BlendBank(dest, source, 0x10, c->timer, 3);
+        off = c->otherBank * 32;
+        source = (u8 *)c + (off + 8);
+        dest = (u8 *)c + (off + 0x208);

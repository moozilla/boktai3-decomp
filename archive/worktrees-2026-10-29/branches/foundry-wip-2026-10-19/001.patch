+void sub_0816CDB8(struct MenuNavigation *s, s32 populate, s32 flags)
+{
+    s32 column, row;
+    struct MenuNavigationCell *base;
+    s->flags = flags;
+    column = 0;
+    base = s->cells.entries;
+    for (; column <= 3;) {
+        s32 next = column + 1;
+        for (row = 0; row <= 8; row++)
+            base[row * 4 + column].value = -1;
+        column = next;
+    }
+    if (populate) {
+        for (column = 0; column <= 3;) {
+            s32 next = column + 1;
+            s32 value;
+            row = 3;

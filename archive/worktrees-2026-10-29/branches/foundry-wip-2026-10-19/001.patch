+s32 Mod(s32, s32);
+static inline s32 RandomValue(void)
+{
+    gUnk_03005308 = (gUnk_03005308 + 1) & 1023;
+    return *(u16 *)((gUnk_03005308 << 1) + (u32)gUnk_0203B400);

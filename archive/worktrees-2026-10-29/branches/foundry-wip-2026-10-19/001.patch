+                else if (0x80 & h)
+                    dir = 2;
+                h = gUnk_03005260.held;
+                if (0x20 & h)
+                    dir |= 4;
+                else if (0x10 & h)
+                    dir |= 8;
+            } else if (0xf0 & gUnk_03005260.held) {
+                p->f1f = c + 1;
+            }
+        }
+    }
+    if (dir & 1) {
+        if ((pos >> 2) == 0)
+            pos = (pos & 3) + 12;
+        else

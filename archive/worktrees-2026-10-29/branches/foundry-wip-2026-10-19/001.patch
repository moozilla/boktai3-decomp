+    u32 pos = p->f1d;
+    u32 dir = 0;
+    k = gUnk_03005260.pressed;
+    if (0x40 & k) {
+        dir = 1;
+    } else if (0x80 & k) {
+        dir = 2;
+    } else if (0x20 & k) {
+        dir = 4;
+    } else {
+        if (0x10 & k)

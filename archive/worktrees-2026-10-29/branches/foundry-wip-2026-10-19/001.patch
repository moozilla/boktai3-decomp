+    entry = (struct GameState *)(index * 2 + (u32)state);
+    base = (s16)entry->baseStats[0];
+    bonus = (s16)entry->statBonuses[0];
+    if (base + bonus + remaining > 100)
+        remaining = 100 - base - bonus;
+    if (remaining > 0) {
+        result = index;
+        goto done;
+    }
+    stats = (s16 *)state->baseStats;
+    for (i = 0; i < 3; i++) {

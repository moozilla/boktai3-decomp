From 94bbcab4f8033ffa74c2a6cc4ad8448dd3beea6d Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Tue, 27 Oct 2026 23:21:33 -0700
Subject: [PATCH] Name the script variable and game state backup pointers

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 include/game_state.h         | 10 +++----
 src/fn/sub_0822BC6C.c        |  5 ++--
 src/script_virtual_machine.c | 54 ++++++++++++++++++------------------
 symbols/ram.csv              |  8 +++---
 4 files changed, 39 insertions(+), 38 deletions(-)

diff --git a/include/game_state.h b/include/game_state.h
index f233086c8..a2aee03d8 100644
--- a/include/game_state.h
+++ b/include/game_state.h
@@ -163,11 +163,11 @@ struct GameState {
 extern struct GameState *gGameState;
 
 /* Backup of gGameState, and the active/backup pair of the shared
- * script-variable region (0x400 bytes each); gUnk_02000700 is the separate,
+ * script-variable region (0x400 bytes each); gScriptLocals is the separate,
  * unbacked local-variable region. Selected together by GameState_SelectRamBase. */
-extern u8 *gUnk_0200070C;
-extern u8 *gUnk_02000708;
-extern u8 *gUnk_02000704;
-extern u8 *gUnk_02000700;
+extern u8 *gGameStateBackup;
+extern u8 *gScriptVariables;
+extern u8 *gScriptVariablesBackup;
+extern u8 *gScriptLocals;
 
 #endif
diff --git a/src/fn/sub_0822BC6C.c b/src/fn/sub_0822BC6C.c
index dafc7dbfc..12f77c6fd 100644
--- a/src/fn/sub_0822BC6C.c
+++ b/src/fn/sub_0822BC6C.c
@@ -1,6 +1,6 @@
 #include "global.h"
 #include "ram.h"
-extern void *gUnk_02000708;
+extern void *gScriptVariables;
 extern u32 *gGameState;
 extern u32 gUnk_03005404;
 u32 Save_AlignSizeToEightBytes(u32);
@@ -9,7 +9,8 @@ s32 Save_ReadBlockWithRetries(u32, void *, u32);
 u32 Save_ReadMainState(u32 arg)
 {
     u32 size = Save_AlignSizeToEightBytes(1024);
-    if (Save_ReadBlockWithRetries((u16)Save_GetPrimaryRegionBlock(arg, 0), gUnk_02000708, size) < 0)
+    if (Save_ReadBlockWithRetries((u16)Save_GetPrimaryRegionBlock(arg, 0), gScriptVariables, size) <
+        0)
         return 0;
     size = Save_AlignSizeToEightBytes(Save_GetMainStateSize());
     if (Save_ReadBlockWithRetries((u16)Save_GetPrimaryRegionBlock(arg, 1), gGameState, size) < 0)
diff --git a/src/script_virtual_machine.c b/src/script_virtual_machine.c
index fa9a65bba..5bc302d79 100644
--- a/src/script_virtual_machine.c
+++ b/src/script_virtual_machine.c
@@ -813,22 +813,22 @@ void GameState_SelectRamBase(void)
     register u8 *base asm("r1") = gGameStateStorage;
     base += (timer & 127) * 8;
     gGameState = (struct GameState *)base;
-    gUnk_0200070C = base + 0xb00;
-    gUnk_02000708 = base + 0x1600;
-    gUnk_02000704 = base + 0x1a00;
-    gUnk_02000700 = base + 0x1e00;
+    gGameStateBackup = base + 0xb00;
+    gScriptVariables = base + 0x1600;
+    gScriptVariablesBackup = base + 0x1a00;
+    gScriptLocals = base + 0x1e00;
 }
 
 void GameState_ClearActiveRegions(void)
 {
-    Memory_Clear(gUnk_02000708, 0x400);
+    Memory_Clear(gScriptVariables, 0x400);
     Memory_Clear(gGameState, 0x89C);
 }
 
 void GameState_ResetActiveRegions(void)
 {
     u16 v = *(u16 *)((u8 *)gGameState + 0x744);
-    Memory_Clear(gUnk_02000708, 0x400);
+    Memory_Clear(gScriptVariables, 0x400);
     Memory_Clear((u8 *)gGameState + 0x30, 0x74A);
     *(u16 *)((u8 *)gGameState + 0x744) = v;
     GameState_BackupActiveRegions();
@@ -836,31 +836,31 @@ void GameState_ResetActiveRegions(void)
 
 void GameState_BackupActiveRegions(void)
 {
-    Memory_Copy(gUnk_0200070C, gGameState, 0x89C);
-    Memory_Copy(gUnk_02000704, gUnk_02000708, 0x400);
+    Memory_Copy(gGameStateBackup, gGameState, 0x89C);
+    Memory_Copy(gScriptVariablesBackup, gScriptVariables, 0x400);
 }
 
 void GameState_RestoreActiveRegions(void)
 {
-    Memory_Copy(gGameState, gUnk_0200070C, 0x89C);
-    Memory_Copy(gUnk_02000708, gUnk_02000704, 0x400);
+    Memory_Copy(gGameState, gGameStateBackup, 0x89C);
+    Memory_Copy(gScriptVariables, gScriptVariablesBackup, 0x400);
 }
 
 void GameState_BackupRegionRange(u8 *p, u32 n)
 {
     s32 d = p - (u8 *)gGameState;
-    Memory_Copy(gUnk_0200070C + d, p, n);
+    Memory_Copy(gGameStateBackup + d, p, n);
 }
 
 u8 *GameState_GetBackupRegionPointer(u8 *p)
 {
     s32 d = p - (u8 *)gGameState;
-    return gUnk_0200070C + d;
+    return gGameStateBackup + d;
 }
 
 void Script_ClearLocalVariables(void)
 {
-    Memory_Clear(gUnk_02000700, 0x400);
+    Memory_Clear(gScriptLocals, 0x400);
 }
 
 struct ScriptShortArrayView {
@@ -909,9 +909,9 @@ u8 *Script_DecodeVariableValue(u8 *p, s32 *type, s32 *value)
     if ((descriptor & 0xF00000) == 0x800000)
         base = (u8 *)gGameState;
     else if ((descriptor & 0xF00000) == 0x100000)
-        base = gUnk_02000700;
+        base = gScriptLocals;
     else
-        base = gUnk_02000708;
+        base = gScriptVariables;
     base += descriptor & 0xFFFF;
     if (((descriptor >> 24) & 0xF0) == 0x20) {
         end = Script_DecodeOperand(p + 4, &ignored, &first);
@@ -971,9 +971,9 @@ u8 *Script_AssignVariableOperand(u8 *p, s32 value)
     if ((descriptor & 0xF00000) == 0x800000)
         base = (u8 *)gGameState;
     else if ((descriptor & 0xF00000) == 0x100000)
-        base = gUnk_02000700;
+        base = gScriptLocals;
     else
-        base = gUnk_02000708;
+        base = gScriptVariables;
     base += descriptor & 0xFFFF;
     if (((descriptor >> 24) & 0xF0) == 0x20) {
         end = Script_DecodeOperand(p + 4, &ignored, &first);
@@ -1012,9 +1012,9 @@ void Script_WriteReferenceValue(struct ScriptUtilityReference *ref, s32 index, s
     if ((descriptor & 0xF00000) == 0x800000)
         base = (u8 *)gGameState;
     else if ((descriptor & 0xF00000) == 0x100000)
-        base = gUnk_02000700;
+        base = gScriptLocals;
     else
-        base = gUnk_02000708;
+        base = gScriptVariables;
     base += descriptor & 0xFFFF;
     if (((descriptor >> 24) & 0xF0) == 0x20)
         index += ref->index;
@@ -1030,9 +1030,9 @@ s32 Script_ReadReferenceValue(struct ScriptUtilityReference *ref, s32 index)
     if ((descriptor & 0xF00000) == 0x800000)
         base = (u8 *)gGameState;
     else if ((descriptor & 0xF00000) == 0x100000)
-        base = gUnk_02000700;
+        base = gScriptLocals;
     else
-        base = gUnk_02000708;
+        base = gScriptVariables;
     base += descriptor & 0xFFFF;
     if (((descriptor >> 24) & 0xF0) == 0x20)
         index += ref->index;
@@ -1052,9 +1052,9 @@ u8 *Script_BackupVariableOperand(u8 *p)
     value = Script_ReadReferenceValue(&ref, 0);
     descriptor = (r[0] << 24) | (r[1] << 16) | (r[2] << 8) | r[3];
     if ((descriptor & 0xF00000) == 0x800000)
-        base = gUnk_0200070C;
+        base = gGameStateBackup;
     else
-        base = gUnk_02000704;
+        base = gScriptVariablesBackup;
     base += descriptor & 0xFFFF;
     if (((descriptor >> 24) & 0xF0) == 0x20)
         index += *(u16 *)(r + 6);
@@ -1073,9 +1073,9 @@ s32 Script_ReadBackupVariableOperand(u8 *p)
     Script_DecodeVariableReference(p, &ref);
     descriptor = (r[0] << 24) | (r[1] << 16) | (r[2] << 8) | r[3];
     if ((descriptor & 0xF00000) == 0x800000)
-        base = gUnk_0200070C;
+        base = gGameStateBackup;
     else
-        base = gUnk_02000704;
+        base = gScriptVariablesBackup;
     base += descriptor & 0xFFFF;
     if (((descriptor >> 24) & 0xF0) == 0x20)
         index += *(u16 *)(r + 6);
@@ -1085,12 +1085,12 @@ s32 Script_ReadBackupVariableOperand(u8 *p)
 
 u8 *GameState_GetBackupStateBase(void)
 {
-    return gUnk_0200070C;
+    return gGameStateBackup;
 }
 
 u8 *GameState_GetBackupVariableBase(void)
 {
-    return gUnk_02000704;
+    return gScriptVariablesBackup;
 }
 
 s32 Div(s32, s32);
diff --git a/symbols/ram.csv b/symbols/ram.csv
index 8bc339d45..e5c4ac8a8 100644
--- a/symbols/ram.csv
+++ b/symbols/ram.csv
@@ -231,10 +231,10 @@ addr,name,size,kind,decl,header,confidence,notes
 02000608,gForgingBook,4,object,extern u32 gForgingBook;,include/ram.h,low,forging book task (ForgingBook_*)
 0200060C,gSaveSignature,4,object,extern u32 gSaveSignature;,include/ram.h,low,signature word of the main save state
 02000610,gScriptVm,70,object,extern struct ScriptVm gScriptVm;,include/script_virtual_machine.h,low,script virtual machine state
-02000700,gUnk_02000700,4,object,,,,
-02000704,gUnk_02000704,4,object,,,,
-02000708,gUnk_02000708,4,object,,,,
-0200070C,gUnk_0200070C,4,object,,,,
+02000700,gScriptLocals,4,object,extern u8 *gScriptLocals;,include/game_state.h,low,"local-variable region of the script VM (0x400 bytes, not backed up)"
+02000704,gScriptVariablesBackup,4,object,extern u8 *gScriptVariablesBackup;,include/game_state.h,low,backup copy of the shared script-variable region
+02000708,gScriptVariables,4,object,extern u8 *gScriptVariables;,include/game_state.h,low,active shared script-variable region (0x400 bytes)
+0200070C,gGameStateBackup,4,object,extern u8 *gGameStateBackup;,include/game_state.h,low,backup of gGameState (0x89C bytes)
 02000710,gGameState,4,object,extern struct GameState *gGameState;,include/game_state.h,low,
 02000714,gHeap,10,object,extern struct HeapBlock gHeap;,include/engine.h,low,"heap header block (Heap_Initialize, Heap_Alloc)"
 0201F400,gHeapEndGuard,4,object,extern u32 gHeapEndGuard;,include/ram.h,low,heap end guard word (0x516B92EE)

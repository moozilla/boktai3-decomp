 0200046C,gFallingObjectManager,4,object,extern struct FallingObjectManager *gFallingObjectManager;,include/falling_objects.h,low,
 02000470,gShadowRegistry,4,object,extern u32 gShadowRegistry;,include/ram.h,low,shadow registry task (ShadowRegistry_*)
@@ -230,7 +230,7 @@ addr,name,size,kind,decl,header,confidence,notes
 02000604,gEnemyParticlePool,4,object,extern u32 gEnemyParticlePool;,include/ram.h,low,enemy particle pool (EnemyParticle_*)
 02000608,gForgingBook,4,object,extern u32 gForgingBook;,include/ram.h,low,forging book task (ForgingBook_*)
 0200060C,gSaveSignature,4,object,extern u32 gSaveSignature;,include/ram.h,low,signature word of the main save state
-02000610,gUnk_02000610,70,object,,,,
+02000610,gScriptVm,70,object,extern struct ScriptVm gScriptVm;,include/script_virtual_machine.h,low,script virtual machine state
 02000700,gUnk_02000700,4,object,,,,

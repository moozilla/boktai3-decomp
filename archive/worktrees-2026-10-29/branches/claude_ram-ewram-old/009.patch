 02000438,gScriptProcedureTable,10,object,extern struct ScriptProcedureTable gScriptProcedureTable;,include/script_virtual_machine.h,low,
-02000448,gUnk_02000448,10,object,,,,
-02000458,gUnk_02000458,4,object,,,,
+02000448,gScriptSections,10,object,extern u8 *gScriptSections[4];,include/script_virtual_machine.h,low,section base pointers resolved from the loaded script header

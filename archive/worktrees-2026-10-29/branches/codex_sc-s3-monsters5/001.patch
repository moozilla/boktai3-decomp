From 0027e217158526e615eefc37c615f451b0d9fa2e Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 02:03:53 -0700
Subject: [PATCH] Resolve explicit function aliases before inline helpers in
 seek

A NONMATCHING block may contain several helper definitions, while its actual function has a file-local alias before the guard. Prefer that mapping when opening a ROM function name.

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/seek/engine.py | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/tools/seek/engine.py b/tools/seek/engine.py
index a47db2872..31b95eca9 100644
--- a/tools/seek/engine.py
+++ b/tools/seek/engine.py
@@ -313,6 +313,13 @@ class Target:
     def __init__(self, src, func=None):
         self.src = os.path.relpath(os.path.abspath(src), ROOT)
         text = open(os.path.join(ROOT, self.src)).read()
+        if func and not find_def(text, func):
+            # File-local function aliases can precede the NONMATCHING guard.
+            # Prefer that explicit mapping over helpers declared in its body.
+            for alias, target in re.findall(r"^\s*#define\s+(\w+)\s+(\w+)\s*$", text, re.M):
+                if target == func and find_def(text, alias):
+                    func = alias
+                    break
         if func and not find_def(text, func):  # a ROM name whose draft has a C name: its block's definition
             for b in scope.nonmatching_blocks(text):
                 if func in b["names"]:
-- 

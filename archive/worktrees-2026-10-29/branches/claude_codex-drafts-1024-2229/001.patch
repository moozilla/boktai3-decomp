-INCLUDE_ASM("asm/nonmatching", sub_0800E5B8);
+#ifdef NONMATCHING
+// fuzzy: 65.9%
+// scope shape 58 (differences once low registers are set aside)
+void StatusScreen_DrawSunSpans(struct StatusScreen *unused)
+{
+    int digits[2];
+    s16 *dst;
+    int row, col, n, base;
+    int *values;
+    u32 hours, minutes;
+    struct StatusGameState *c = &gUnk_03005430;
+    if (!c)
+        return;
+    if (c->mode == 0 || c->mode == 4 || c->mode == 5) {
+        dst = (s16 *)StatusScreen_GetTilePtr(0, 4, 15);
+        hours = gUnk_03005430.altCounters[0];
+        minutes = gUnk_03005430.altCounters[1];
+    } else {
+        dst = (s16 *)StatusScreen_GetTilePtr(0, 4, 15);
+        hours = gUnk_03005430.counters[0];
+        minutes = gUnk_03005430.counters[1];
+    }
+    for (row = 0; row < 2; row++) {
+        int shift = row << 4;
+        int tile = shift + 0x6a;
+        s16 *out = dst;
+        for (col = 0; col < 4; col++)
+            *out++ = (tile + col) | -12288;
+        dst += gUnk_03004C30[0].width * 2;
+    }
+
+    dst = (s16 *)StatusScreen_GetTilePtr(0, 8, 15);
+    if (gUnk_03005430.mode == 0 || gUnk_03005430.mode == 4 || gUnk_03005430.mode == 5) {
+        n = 2;
+        base = 0x6e;
+    } else {
+        n = 2;
+        base = 0x4e;
+    }
+    for (row = 0; row < 2; row++) {
+        int shift = row << 4;
+        s16 *out = dst;
+        for (col = 0; col < n; col++)
+            *out++ = (shift + base + col) | -12288;
+        dst += gUnk_03004C30[0].width * 2;
+    }
+
+    digits[0] = Div(hours, 10);
+    digits[1] = hours - digits[0] * 10;
+    dst = (s16 *)StatusScreen_GetTilePtr(0, 16, 15);
+    do {
+        row = 0;
+        values = digits;
+    } while (0);
+    for (; row < 2; row++) {
+        int shift = row << 4;
+        int *digit = values;
+        s16 *out = dst;
+        for (col = 0; col < 2; col++) {
+            int tile = *digit++ + 0x60;
+            *out++ = shift + tile | -12288;
+        }
+        dst += gUnk_03004C30[0].width * 2;
+    }
+
+    digits[0] = Div(minutes, 10);
+    digits[1] = minutes - digits[0] * 10;
+    dst = (s16 *)StatusScreen_GetTilePtr(0, 22, 15);
+    row = 0;
+    values = digits;
+    for (; row < 2;) {
+        int next = row + 1;
+        row <<= 4;
+        {
+            int *digit = values;
+            s16 *out = dst;
+            for (col = 0; col < 2; col++) {
+                int tile = *digit++ + 0x60;
+                *out++ = row + tile | -12288;
+            }
+            dst += gUnk_03004C30[0].width * 2;
+        }
+        row = next;
+    }
+}
+#else
+INCLUDE_ASM("asm/nonmatching", StatusScreen_DrawSunSpans);
+#endif
 
 void StatusScreen_RefreshDirtyDisplays(struct StatusScreen *s)
 {
@@ -110,7 +197,7 @@ void StatusScreen_RefreshDirtyDisplays(struct StatusScreen *s)
     if (s->dirty & 2)
         NumericDisplay_DrawStatusValues(s);
     if (s->dirty & 4)
-        sub_0800E5B8(s);
+        StatusScreen_DrawSunSpans(s);
     s->dirty = 0;
 }
 

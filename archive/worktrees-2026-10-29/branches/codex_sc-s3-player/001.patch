From aaa6709b88312e6514756c41af56d916a8031ce0 Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 02:01:36 -0700
Subject: [PATCH] Guard statement swaps against value and memory dependencies

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/rewrites.py | 34 ++++++++++++++++++++++++++++++++++
 1 file changed, 34 insertions(+)

diff --git a/tools/rewrites.py b/tools/rewrites.py
index eb0734c86..42091376a 100644
--- a/tools/rewrites.py
+++ b/tools/rewrites.py
@@ -328,12 +328,46 @@ def rw_commute(fn):
 
 def rw_swap_stmts(fn):
     """Swap two adjacent statements (scheduling / evaluation order)."""
+    def effects(stmt):
+        reads, writes = set(), set()
+        memory_read = memory_write = unsafe = False
+        for n, p, slot in walk(stmt):
+            if isinstance(n, (ca.FuncCall, ca.Return, ca.Goto, ca.Label,
+                              ca.Break, ca.Continue, ca.For, ca.While, ca.DoWhile)):
+                unsafe = True
+            if isinstance(n, ca.ID):
+                if isinstance(p, ca.StructRef) and slot == "field":
+                    continue
+                if isinstance(p, ca.Assignment) and slot == "lvalue":
+                    writes.add(n.name)
+                    if p.op != "=":
+                        reads.add(n.name)
+                elif isinstance(p, ca.UnaryOp) and p.op in ("p++", "p--", "++", "--"):
+                    reads.add(n.name)
+                    writes.add(n.name)
+                else:
+                    reads.add(n.name)
+            if isinstance(n, (ca.ArrayRef, ca.StructRef)) or isinstance(n, ca.UnaryOp) and n.op == "*":
+                if isinstance(p, ca.Assignment) and slot == "lvalue":
+                    memory_write = True
+                    memory_read |= p.op != "="
+                elif isinstance(p, ca.UnaryOp) and p.op in ("p++", "p--", "++", "--"):
+                    memory_read = memory_write = True
+                elif not (isinstance(p, ca.UnaryOp) and p.op == "&"):
+                    memory_read = True
+        return reads, writes, memory_read, memory_write, unsafe
+
     bl = blocks(fn)
     for bi, b in enumerate(bl):
         for i in range(len(b.block_items) - 1):
             x, y = b.block_items[i], b.block_items[i + 1]
             if isinstance(x, (ca.Decl, ca.Label, ca.Return)) or isinstance(y, (ca.Decl, ca.Label)):
                 continue
+            xr, xw, xmr, xmw, xu = effects(x)
+            yr, yw, ymr, ymw, yu = effects(y)
+            if (xu or yu or xw & (yr | yw) or yw & (xr | xw)
+                    or xmw and (ymr or ymw) or ymw and (xmr or xmw)):
+                continue
             f2 = copy.deepcopy(fn)
             b2 = blocks(f2)[bi]
             b2.block_items[i], b2.block_items[i + 1] = b2.block_items[i + 1], b2.block_items[i]
-- 

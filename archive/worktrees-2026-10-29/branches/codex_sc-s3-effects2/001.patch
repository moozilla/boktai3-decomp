@@ -366,7 +366,8 @@ class Target:
             path = os.path.join(LOCAL, "cache", f"pri{os.getpid()}.txt")
             open(path, "w").close()
             knobs["AGBCC_DUMPPRI"] = path
-        code, err = self.fast.bytes(pre, self.names, knobs)
+        own = fast.bundle_names(pre, self.names, self.addr, self.size)
+        code, err = self.fast.bytes(pre, own, knobs)
         self.compiles += 1

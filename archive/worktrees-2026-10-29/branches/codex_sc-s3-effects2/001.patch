From 3ee9d6fc940e30b5835980d640c7e985e7411b6a Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 04:20:34 -0700
Subject: [PATCH] Keep recovered interior routines in reviewed scope and seek
 extents

Compile and extract address-named interior routines together with their inventory entry. Preserve the reviewed ROM target length. Verified combined fast output against per-unit linker bytes and checked an ordinary exact match remains exact.

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/scope/README.md |  9 +++++++++
 tools/scope/fast.py   | 22 +++++++++++++++++++++-
 tools/scope/scope.py  | 12 +++++++++---
 tools/seek/engine.py  |  3 ++-
 4 files changed, 41 insertions(+), 5 deletions(-)

diff --git a/tools/scope/README.md b/tools/scope/README.md
index 8dc1b3847..029ed49be 100644
--- a/tools/scope/README.md
+++ b/tools/scope/README.md
@@ -1035,3 +1035,12 @@ which is exactly `10:1`. Not tested.
   name; now they fall back to the only function in the dump), and a trailing
   FUNC argument to `life` was read as a variable name; a `sub_ADDR` name that
   the CSV has since renamed raised a KeyError.
+
+### Inventory entries containing several routines
+
+An inventory entry can include an undrafted routine after the first return. `seek facts`
+reports likely interior entry addresses. Recover these as additional C definitions in the
+same NONMATCHING block, using `sub_ADDR` names (a file-local descriptive alias is fine).
+Scope and seek keep definitions whose encoded addresses fall inside the reviewed inventory
+extent, and compare their combined bytes. The extent is never shortened to accept only the
+first routine. Per-unit `tools/check.py --nonmatching` remains the independent check.
diff --git a/tools/scope/fast.py b/tools/scope/fast.py
index bd66b84c4..65933d78f 100644
--- a/tools/scope/fast.py
+++ b/tools/scope/fast.py
@@ -27,6 +27,20 @@ MARK = "\x01"  # right after the prefix's last newline: no extra line
 HELPER_CHARS = 12000  # longest unit-local stretch before FUNC sent with every request
 
 
+def bundle_names(text, own, address, size):
+    """Include named interior routines in one reviewed ROM inventory extent.
+
+    Some inventory entries contain several routines. Their recovered C definitions
+    use sub_ADDR names (possibly through a source alias) until the inventory is
+    split. Do not truncate the candidate at the first interior routine.
+    """
+    extra = []
+    for m in re.finditer(r"^[^\n;#]*\b(sub_([0-9A-Fa-f]{8}))\s*\([^;{]*\)\s*\{", text, re.M):
+        if address < int(m[2], 16) < address + size and m[1] not in own:
+            extra.append(m[1])
+    return tuple(own) + tuple(dict.fromkeys(extra))
+
+
 def split_source(text, func_names):
     """(prefix, suffix): the suffix starts at the definition of one of FUNC_NAMES.
     None when the text has no such definition or contains the marker byte."""
@@ -54,6 +68,12 @@ def split_source(text, func_names):
     # and end the suffix with FUNC's body: agbcc compiles a function at a time, so what follows cannot
     # change FUNC's code, and a big unit's later functions would otherwise compile with every variant
     end = body_end(text, m.end() - 1)
+    # OWN may also name interior routines in the same reviewed inventory entry.
+    # Compile them in source order along with the entry function.
+    for name in func_names:
+        for tail in re.finditer(r"^[^\n;#]*\b" + re.escape(name) + r"\s*\([^;{]*\)\s*\{", text, re.M):
+            if tail.start() >= m.start():
+                end = max(end, body_end(text, tail.end() - 1))
     return text[:start], text[start:end]
 
 
@@ -190,7 +210,7 @@ def place(obj, own, rom_syms, address):
     start = next((v for v, n in funcs if n in own), None)
     if start is None:
         return None, None, funcs, ["no " + "/".join(own)]
-    end = next((v for v, n in funcs if v > start), len(text))
+    end = next((v for v, n in funcs if v > start and n not in own), len(text))
     base = address - start  # address of .text offset 0
     local = {n: base + (v & ~1) + (v & 1) for n, v, sh, t in syms if sh == text_i and n}
     local_funcs = {n for _, n in funcs} - set(own)
diff --git a/tools/scope/scope.py b/tools/scope/scope.py
index 055648127..3be54e049 100644
--- a/tools/scope/scope.py
+++ b/tools/scope/scope.py
@@ -406,8 +406,12 @@ def compile_draft_g(src, func, env=None):
     env = resolve_knobs(src, func, env)
     wd = workdir(func)
     pre = preprocess(src, env, func)
+    import fast
+    _, bundle_addr, bundle_sizes = inventory()
+    key = rom_name(src, func)
+    own = fast.bundle_names(pre, (func, key), bundle_addr[key], bundle_sizes[key])
     if os.environ.get("SCOPE_TRIM") != "0":
-        pre = diagnostic_source(pre, (func, rom_name(src, func))) or pre
+        pre = diagnostic_source(pre, own) or pre
     open(os.path.join(wd, "u.i"), "w").write(pre)
     for p in PASSES:
         try:
@@ -476,7 +480,6 @@ def compile_draft_g(src, func, env=None):
     # earlier drafts of other sizes move: send such calls to the callee's ROM address instead, so
     # they compare like calls to outside symbols (a phantom bl difference otherwise).
     _, addr_all, _ = inventory()
-    own = (func, rom_name(src, func))
     local = set(re.findall(r"^\t\.type\t\s*(\w+),function", text, re.M)) - set(own)
     for n in sorted(local):
         a_rom = addr_all.get(n)
@@ -2368,7 +2371,10 @@ def fast_compile(src, func, env=None, plain=None):
         atexit.register(f.close)  # stops its agbcc servers and removes their directories
         os.makedirs(os.path.join(WORK, "cache"), exist_ok=True)
     knobs = {k: v for k, v in (env or {}).items() if k.startswith(("AGBCC_", "CSE_"))}
-    code, err = f.bytes(fast_preprocess(src, env, func), (func, rom_name(src, func)), knobs)
+    pre = fast_preprocess(src, env, func)
+    _, _, sizes = inventory()
+    own = fast.bundle_names(pre, (func, rom_name(src, func)), addr, sizes[rom_name(src, func)])
+    code, err = f.bytes(pre, own, knobs)
     if code is None:
         return None
     return code, addr, f.data

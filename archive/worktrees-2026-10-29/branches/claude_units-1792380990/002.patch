+                                    {
+                                        u32 value = *pair;
+                                        *firstOutput = value;
+                                    }
+                                    {
+                                        register s32 index asm("r0") = dy + 1;
+                                        index *= 32;
+                                        index = dx + index;
+                                        secondOutput = output + index;
+                                    }
+                                    secondValue = pair[2];
+                                } else {
+                                    u16 *firstOutput;
+                                    u16 *tileBuffer, *pair;
+                                    {
+                                        register s32 index asm("r1") = dy * 32;
+                                        index = dx + index;
+                                        firstOutput = output + index;
+                                    }
+                                    tileBuffer =
+                                        ((struct SceneOverlayLayer *)SCENE_OVERLAY_LAYER_ADDR)

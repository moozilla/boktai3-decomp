+void ScenePanel_SetEffectState(struct ScenePanel *input, u16 state)
+{
+    struct ScenePanel *panel = input;
+    panel->effectState = state;
+    panel->effectFrame = 0;
+}
+
+void ScenePanel_CallPendingScript(struct ScenePanel *input, u32 value)
+{
+    struct ScenePanel *panel = input;
+    u32 scriptId = panel->pendingScriptId;
+    if (scriptId) {
+        s32 argument;
+        struct ScenePanelScriptArguments arguments;
+        arguments.count = (arguments.count & 0xFFFF0000) | 1;
+        argument = value;
+        arguments.values = &argument;
+        Script_Call(scriptId, &arguments);
+    }
+}
+
+void ScenePanel_UpdateParticles(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    struct ScenePanelParticles *particles = &panel->particles;
+    if (particles->active) {
+        u32 anyActive = 0;
+        s32 i;
+        for (i = 0; i < 32; i++) {
+            struct ScenePanelParticle *particle = &particles->entries[i];
+            if (particle->active) {
+                if (particle->age >= particle->lifetime) {
+                    particle->flags |= 1;
+                    particle->active = 0;
+                } else {
+                    anyActive = 1;
+                    particle->position.world.x += particle->velocity.world.x;
+                    particle->position.world.y += particle->velocity.world.y;
+                    particle->position.world.z += particle->velocity.world.z;
+                    if (particle->age == 6)
+                        SpriteDrawable_SelectTileFrame(particle, particles->resource, 3);
+                    particle->age++;
+                }
+            }
+        }
+        particles->active = anyActive;
+    }
+}
+
+void ScenePanel_AddParticle(struct ScenePanel *input, union ScenePanelPosition *position,
+                            union ScenePanelPosition *velocity, u32 lifetime, u32 renderMode)
+{
+    struct ScenePanel *panel = input;
+    struct ScenePanelParticles *particles = &panel->particles;
+    struct ScenePanelParticle *particle = &particles->entries[particles->cursor];
+    particle->flags &= ~1;
+    particle->position = *position;
+    particle->renderMode = renderMode;
+    SpriteDrawable_SelectTileFrame(particle, particles->resource, 2);
+    particle->velocity = *velocity;
+    particle->age = 0;
+    particle->lifetime = lifetime;
+    particle->active = 1;
+    particles->active = 1;
+    particles->cursor++;
+    if (particles->cursor > 31)
+        particles->cursor = 0;
+}
+
+void ScenePanel_DestroyParticles(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    struct ScenePanelParticle *particle = panel->particles.entries;
+    s32 i;
+    for (i = 31; i >= 0; i--) {
+        Effect_Remove(particle);
+        particle++;
+    }
+}
+
+void ScenePanel_InitParticles(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    struct ScenePanelParticles *particles = &panel->particles;
+    s32 i;
+    s32 scale;
+    particles->resource = AnimData_FindEntry(0x1C1E);
+    particles->active = 0;
+    i = 0;
+    scale = -4;
+    for (; i < 32; i++) {
+        struct ScenePanelParticle *particle = &particles->entries[i];
+        sub_08217DE0(particle, particles->resource, 1);
+        Effect_SetOrigin(particle, scale, scale);
+        Effect_SetPalette(particle, 1);
+        particle->active = 0;
+    }
+}
+
+void ScenePanel_SelectTimePalette(struct ScenePanel *input, s32 phase)
+{
+    struct ScenePanel *panel = input;
+    switch (panel->timePhase) {
+        case 0:
+            panel->previousPalette = 2;
+            panel->targetPalette = 2;
+            break;
+        case 1:
+            panel->previousPalette = 2;
+            panel->targetPalette = 0;
+            panel->paletteBlendActive = 1;
+            panel->paletteBlendFrame = 0;
+            break;
+        case 2:
+            panel->previousPalette = 0;
+            panel->targetPalette = 0;
+            break;
+        case 3:
+            panel->previousPalette = 0;
+            panel->targetPalette = 1;
+            panel->paletteBlendActive = 1;
+            panel->paletteBlendFrame = 0;
+            break;
+        case 4:
+            panel->previousPalette = 1;
+            panel->targetPalette = 2;
+            panel->paletteBlendActive = 1;
+            panel->paletteBlendFrame = 0;
+            break;
+        case 5:
+            panel->previousPalette = 2;
+            panel->targetPalette = 2;
+            break;
+    }

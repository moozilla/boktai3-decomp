+// MATCHING_CONCESSION: register-pinning
+void ScenePanel_InitScheduledAction(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    register void (**destination)(struct ScenePanel *) asm("r1");
+    register void (*action)(struct ScenePanel *) asm("r0");
+    u32 handleOffset;
+    /* Cache the handle offset for the neighboring interval field. */
+    switch (panel->resourceIndex) {
+        case 0:
+            panel->actionHandle = 0;
+            handleOffset = 0x1364;
+            destination = &panel->action;
+            action = ScenePanel_TickHazardSpawner;
+            goto shared;
+        case 1:
+            panel->actionHandle = Hresvelgr_CreateShotPool(panel->actionResourceId, 10, 30);
+            handleOffset = 0x1364;
+            destination = &panel->action;
+            action = ScenePanel_TickAngleBurst;
+            goto shared;
+        case 2:
+            panel->actionHandle = SceneEffect_CreateMovingTask(panel->actionResourceId, &panel->overlayOrigin);
+            handleOffset = 0x1364;
+            destination = &panel->action;
+            action = ScenePanel_TickHandleActionB;
+            goto shared;
+        case 3:
+            panel->actionHandle =
+                ScenePanelEffect_Create(panel->actionResourceId, panel->actionParameter);
+            panel->action = ScenePanel_TickHandlePosition;
+            panel->actionInterval = 360;
+            break;
+        case 4:
+            panel->actionHandle = SceneEffect_CreateEntryTask(panel->actionResourceId, &panel->overlayOrigin);
+            handleOffset = 0x1364;
+            destination = &panel->action;
+            action = ScenePanel_TickHandleActionA;
+        shared:
+            *destination = action;
+            {
+                u16 *interval;
+                u32 duration;
+                handleOffset -= 0x16;
+                /* Keep the runtime offset: a direct field address changes agbcc allocation. */
+                interval = (void *)((u8 *)panel + handleOffset);
+                duration = 600;
+                *interval = duration;
+            }
+            break;
+        default: {
+            register u32 offset asm("r0") = 0x1360;
+            asm("" : "+r"(offset));
+            /* Preserve the original register-held offset for the null callback store. */
+            destination = (void *)((u8 *)panel + offset);
+            action = 0;
+            *destination = action;
+            break;
+        }
+    }
+}

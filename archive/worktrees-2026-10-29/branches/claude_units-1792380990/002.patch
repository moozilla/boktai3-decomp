+void ScenePanel_TickHazardSpawner(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    if (++panel->actionFrame >= panel->actionInterval) {
+        struct ContactPackedVector position;
+        position.x = gUnk_02000710->positionX;
+        position.y = gUnk_02000710->positionY;
+        position.z = gUnk_02000710->positionZ;
+        AnimatedHazard_Create(&position, panel->actionResourceId, 30);
+        panel->actionStep = 0;
+        panel->actionFrame = 0;
+    }
+}
+
+void ScenePanel_TickAngleBurst(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    if (panel->actionFrame < panel->actionInterval) {
+        if (++panel->actionFrame >= panel->actionInterval) {
+            u32 angle = Math_Atan2(gUnk_02000710->positionX - panel->overlayOrigin.x,
+                                   gUnk_02000710->positionZ - panel->overlayOrigin.z) -
+                        32;
+            u16 *destination = &panel->actionAngle;
+            *destination = angle & 255;
+            panel->actionStep = 0;
+        }
+    } else {
+        if (panel->actionStep == 0)
+            Sound_PlaySong(994);
+        if (panel->actionStep <= 4) {
+            DirectionBurst_Emit(&panel->overlayOrigin, panel->actionAngle, 12, 100);
+            panel->actionAngle = (panel->actionAngle + 16) & 255;
+            panel->actionStep++;
+        } else
+            panel->actionFrame = 0;
+    }
+}
+
+void ScenePanel_TickHandlePosition(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    if (++panel->actionFrame >= panel->actionInterval) {
+        Math_Atan2(gUnk_02000710->positionX - panel->overlayOrigin.x,
+                   gUnk_02000710->positionZ - panel->overlayOrigin.z);
+        sub_08190B10(panel->actionHandle, &panel->overlayOrigin, gUnk_0824DEA4);
+        panel->actionStep = 0;
+        panel->actionFrame = 0;
+    }
+}
+
+void ScenePanel_TickHandleActionA(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    if (++panel->actionFrame >= panel->actionInterval) {
+        SceneBurstEmitter_RequestCleanup(panel->actionHandle);
+        panel->actionStep = 0;
+        panel->actionFrame = 0;
+    }
+}
+
+void ScenePanel_TickHandleActionB(struct ScenePanel *input)
+{
+    struct ScenePanel *panel = input;
+    if (++panel->actionFrame >= panel->actionInterval) {
+        SceneOrbitHazard_Activate(panel->actionHandle);
+        panel->actionStep = 0;
+        panel->actionFrame = 0;
+    }
+}

From c21a78eb635bd8e38f5cd46ebe75ed5991005c33 Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 04:22:50 -0700
Subject: [PATCH] Allow skipping automatic seek add spill probes

SEEK_ADD_ROTATION=0 keeps batches of near-match hypotheses fast when allocation is already diagnosed. Default behavior remains unchanged.

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/seek/seek.py | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/tools/seek/seek.py b/tools/seek/seek.py
index be1de27d1..700592cea 100644
--- a/tools/seek/seek.py
+++ b/tools/seek/seek.py
@@ -23,6 +23,7 @@
   seek.py land N                      a MATCH node: hand it to `campaign.py land` (unwraps NONMATCHING)
 
 SEEK_JOBS=4 compiles expansions in four processes (each with its own agbcc fork server).
+SEEK_ADD_ROTATION=0 skips the automatic spill-rotation probe when adding near-match files.
 
 Options: -f FUNC picks the session (default: the last one opened in this tree).
 Sessions are shared across worktrees ($SEEK_HOME, default: the main checkout's build/seek).
@@ -263,7 +264,7 @@ class Work:
         code, err, alloc = self.target.compile_pre(pre, trace=True)
         nrel = alloc.pop("__reloads__", 0)
         ev = self.target.evaluate(code)
-        if code and not ev.get("match") and ev["key"][2] <= 12:
+        if code and not ev.get("match") and ev["key"][2] <= 12 and os.environ.get("SEEK_ADD_ROTATION", "1") != "0":
             ev["rot"] = self.target.rotation(pre, nrel) or [ev["key"][2], -1, 99]
         out = sha(code) if code else None
         rec = dict(parent=parent["id"] if parent else None, kind="file", who=who, file=fh, defs={},
-- 

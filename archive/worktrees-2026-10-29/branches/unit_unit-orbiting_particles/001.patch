+        case 3:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 4;
+            break;
+        case 4:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 6;
+            break;
+        case 5:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 8;

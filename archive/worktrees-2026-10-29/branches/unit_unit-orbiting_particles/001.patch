+    return 0;
+}
+
+u32 OrbitingParticles_Destroy(struct OrbitingParticles *p)
+{
+    s32 i;
+    struct OrbitingParticleSprite *q = &p->orbs[0].sprite;
+    for (i = 7; i >= 0; i--) {
+        Effect_Remove(q);

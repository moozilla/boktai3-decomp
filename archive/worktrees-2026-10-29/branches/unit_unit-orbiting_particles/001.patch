+        case 6:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 10;
+            break;
+        case 7:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 12;
+            break;
+        case 8:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 14;
+            break;
+        case 0:
+        case 2:
+        default:
+            m->resource = AnimData_FindEntry(0x1c1e);
+            m->frame = 2;
+            break;
+    }
+    m->position = *source;
+    pos = &m->position;
+    {

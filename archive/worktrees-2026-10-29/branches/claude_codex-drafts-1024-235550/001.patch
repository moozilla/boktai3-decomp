+void sub_08193874(void *src, struct Sub08193874Hit *c, struct Nidhoggr *t)
+{
+    s32 part;
+    s32 slot = 0;
+    s32 sl = 0;
+    s32 dmg;
+    s32 total;
+    s32 th1, th2, th3;
+    s16 *gh;
+    s32 saved;
+
+    Collision_CalculateDamageResponse(src);
+    dmg = c->damage;
+    PlayerStats_AddContactHundredths(src, c, t->optionS);
+    part = sub_08249420((u8 *)c - 0x66D8 - (u8 *)t, 0x54);
+    if (t->rowBlink[part] != 0)
+        return;
+    t->rowBlink[part] = ((struct Sub08193874Source *)src)->power;
+
+    gh = &t->groupHpA;
+    total = gh[0] + gh[1];
+    if ((u32)part <= 1) {
+        s32 y = t->optionY;
+        th1 = y >> 2;
+        th2 = y >> 1;
+        th3 = (y * 3) >> 2;
+        slot = part;
+        if (gh[slot] <= 0)
+            return;
+        if (t->attackActive == 0) {
+            Sound_PlaySongChecked(0x211);
+            return;
+        }
+        saved = gh[slot];
+        gh[slot] = saved - dmg;
+        if (gh[slot] < 0) {
+            dmg += gh[slot];
+            gh[slot] = sl;
+        }
+        total = gh[0] + gh[1];
+        if (total <= 0 && t->mode != 6)
+            Nidhoggr_SetBehavior(t, 12);
+        dmg = Sub08193874_Life(t, dmg, total);
+        Sub08193874_Report(t, c, part, dmg, 1);
+        if (gh[slot] > 0) {
+            if (slot == 0)
+                t->flags[2] &= 0xFB;
+            else
+                t->flags[2] &= 0xF7;
+            if (dmg != 0)
+                Sound_PlaySongChecked(0x13E);
+            else
+                Sound_PlaySong(0x211);
+            if (c->flags & 4)
+                Nidhoggr_EmitSparks((u32)c + 0x24);
+        } else {
+            if (slot == 0)
+                t->flags[2] |= 4;
+            else
+                t->flags[2] |= 8;
+            Sound_PlaySongChecked(0x1BB);
+            Nidhoggr_CreateBurstEffects(&t->effectPool, (u8 *)c + 0x24);
+        }
+        Sub08193874_Level(t, c, slot, gh[slot], th1, th2, th3);
+        return;
+    }
+
+    switch (t->mode) {
+        case 2:
+        case 3:
+        case 8:
+            if ((u32)(part - 6) <= 3) {
+                slot = part - 6;
+                sl = 5;
+            } else if ((u32)(part - 14) <= 3) {
+                slot = part - 10;
+                sl = 10;
+            } else if (part == 19) {
+                slot = 8;
+                sl = 15;
+            } else {
+                return;
+            }
+            break;
+        case 4:
+        case 5:
+        case 9:
+            if ((u32)(part - 2) <= 3) {
+                slot = part - 2;
+                sl = 5;
+            } else if ((u32)(part - 10) <= 3) {
+                slot = part - 6;
+                sl = 10;
+            } else if (part == 18) {
+                slot = 8;
+                sl = 15;
+            } else {
+                return;
+            }
+            break;
+        default:
+            slot = 0;
+            sl = 0;
+            break;
+    }
+
+    if (t->hp[slot] <= 0)
+        return;
+    saved = t->hp[slot];
+    t->hp[slot] = saved - dmg;
+    if (t->hp[slot] > 0) {
+        if (dmg != 0)
+            Sound_PlaySongChecked(0x13E);
+        else
+            Sound_PlaySong(0x211);
+        if (c->flags & 4)
+            Nidhoggr_EmitSparks((u32)c + 0x24);
+    } else {
+        dmg += t->hp[slot];
+        t->hp[slot] = 0;
+        t->dead[slot] = 0;
+        SceneAnimation_SetSlotState(t, part, sl);
+        if ((u8)(t->state - 2) <= 1)
+            t->posOffsetXVelocity = -0x600;
+    }
+    total = t->groupHpA + t->groupHpB;
+    dmg = Sub08193874_Life(t, dmg, total);
+    Sub08193874_Report(t, c, part, dmg, 2);
+}

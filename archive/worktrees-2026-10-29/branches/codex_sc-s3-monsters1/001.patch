From 3f02759b25224dbca81d316c031860a87ee077e4 Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 01:49:18 -0700
Subject: [PATCH] Honor seek search limits within large expansions

Apply the remaining compile budget when expanding a node, check the time limit between small compile batches, and keep incomplete expansions eligible for later work.

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/seek/seek.py | 29 +++++++++++++++++++++++------
 1 file changed, 23 insertions(+), 6 deletions(-)

diff --git a/tools/seek/seek.py b/tools/seek/seek.py
index ae9fea74d..69fd0ab7f 100644
--- a/tools/seek/seek.py
+++ b/tools/seek/seek.py
@@ -289,7 +289,7 @@ class Work:
         return rec
 
     # -- expanding
-    def expand(self, node, families=None, lines=None, quiet=False, budget=None, sem=True):
+    def expand(self, node, families=None, lines=None, quiet=False, budget=None, sem=True, deadline=None):
         """Every move at NODE: compile, evaluate, add the distinct outputs as children. Returns
         (children, stats)."""
         pre, defs = self.pre_of(node)
@@ -318,9 +318,15 @@ class Work:
         self.hint = r[1:] if r and r[0] == 0 else None
         for dname, fn in defs.items():
             seen_src.add(sha(R.text(fn)))
+        limited = False
+        task_budget = None if budget is None else max(0, budget - 1)
         for dname, fn in defs.items():
+            if limited:
+                break
             for fam, desc, f2 in M.all_moves(fn, families):
-                if budget is not None and len(tasks) >= budget:
+                if ((task_budget is not None and len(tasks) >= task_budget)
+                        or (deadline is not None and time.time() >= deadline)):
+                    limited = True
                     break
                 line = changed_line(fn, f2)
                 if lines and line not in lineset:
@@ -334,8 +340,17 @@ class Work:
                     continue
                 seen_src.add(h)
                 tasks.append((dname, fam, desc, f2, txt, line))
-        stats["variants"] = len(tasks)
-        for (dname, fam, desc, f2, txt, line), res in zip(tasks, self.compile_all(base_pre, tasks)):
+        def evaluated_tasks():
+            nonlocal limited
+            for offset in range(0, len(tasks), 16):
+                if deadline is not None and time.time() >= deadline:
+                    limited = True
+                    break
+                batch = tasks[offset:offset + 16]
+                results = self.compile_all(base_pre, batch)
+                stats["variants"] += len(batch)
+                yield from zip(batch, results)
+        for (dname, fam, desc, f2, txt, line), res in evaluated_tasks():
             fs = stats["fam"].setdefault(fam, [0, 0, 0])  # tried, changed code, better
             fs[0] += 1
             if res is None:
@@ -368,6 +383,7 @@ class Work:
             self.ast[rec["id"]] = (vpre, kid_defs)
             children.append(rec)
             stats["new"] += 1
+        stats["incomplete"] = limited
         stats["seconds"] = round(time.time() - t0, 2)
         self.sess.event(kind="expand", node=node["id"], families=sorted(families) if families else None,
                         lines=lines, **{k: v for k, v in stats.items() if k != "fam"})
@@ -385,7 +401,7 @@ class Work:
         start_compiles = self.target.compiles
         heap, tick = [], 0
         sig = (tuple(sorted(families)) if families else None, tuple(lines) if lines else None)
-        done = {e["node"] for e in self.sess.events if e.get("kind") == "expand"
+        done = {e["node"] for e in self.sess.events if e.get("kind") == "expand" and not e.get("incomplete")
                 and (tuple(e["families"]) if e.get("families") else None, tuple(e["lines"]) if e.get("lines") else None) == sig}
         for n in starts:
             heapq.heappush(heap, (rank(n), n.get("awrong", 0), n.get("depth", 0), tick, n["id"]))
@@ -408,7 +424,8 @@ class Work:
             node = self.sess.nodes[nid]
             try:
                 kids, st = self.expand(node, families, lines, quiet=True,
-                                       budget=None)
+                                       budget=budget - (self.target.compiles - start_compiles),
+                                       deadline=t0 + seconds)
             except SystemExit as e:
                 print(f"  n{nid}: {e}")
                 continue

From 02ffa3163a964698be6b037ae95549154ecbf0cc Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 02:28:08 -0700
Subject: [PATCH] Fix seek type-edit locations and block search ranking

Include scalar list attributes such as IdentifierType.names in AST comparisons so width moves retain their source lines. Rank the selected block before whole-function skeleton differences, as the block search workflow promises.

Validated on Bat_Init: all five attack-index width moves now map to their declaration line and are evaluated by the block search.

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/seek/seek.py | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/tools/seek/seek.py b/tools/seek/seek.py
index 69fd0ab7f..50000e849 100644
--- a/tools/seek/seek.py
+++ b/tools/seek/seek.py
@@ -122,7 +122,7 @@ def changed_line(fn, f2):
 
 
 def shallow(n):
-    return tuple((k, getattr(n, k)) for k in n.attr_names if not isinstance(getattr(n, k), (list, dict)))
+    return tuple((k, getattr(n, k)) for k in n.attr_names)
 
 
 # ------------------------------------------------------------------ the engine's state in one process
@@ -514,7 +514,7 @@ def rank(n):
         r = n["rot"]  # [diff after the best single shift, K, D]
         return (k[0], r[0], r[2] if r[0] == 0 else 99, cost)
     if mode == "block" and n.get("blk") is not None:
-        return (k[0], n["blk"], cost, k[1])
+        return (0, n["blk"], k[0], cost)
     return (k[0], cost, k[1], k[2])
 
 

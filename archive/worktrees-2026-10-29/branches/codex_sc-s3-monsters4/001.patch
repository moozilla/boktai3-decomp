From c24a524b8d14d08476ec0b34fa9fc6e667a4bdef Mon Sep 17 00:00:00 2001
From: Campaign Worker <>
Date: Thu, 29 Oct 2026 02:17:34 -0700
Subject: [PATCH] Add instruction-first objective for seek searches

Allow workers to rank shape and differing instructions ahead of reviewed fact gaps, including stack frames and literal-pool multiplicity affected by register allocation. Preserve the default facts-first ordering. Apply the objective before selecting automatic starting nodes.

Co-Authored-By: GPT-6.1 Sol (Codex) <noreply@openai.com>
---
 tools/seek/seek.py | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/tools/seek/seek.py b/tools/seek/seek.py
index ae9fea74d..12ed738bd 100644
--- a/tools/seek/seek.py
+++ b/tools/seek/seek.py
@@ -485,7 +485,9 @@ def rank(n):
     Objective "rotation": among nodes whose code is right up to reload's spill rotation, the one
     needing the smallest shift first (a C change that adds or removes one reload choice before the
     differing one moves the shift by one: a gradient where the insn count shows none).
-    Objective "block": the cost inside one ROM block first, the rest of the function second."""
+    Objective "block": the cost inside one ROM block first, the rest of the function second.
+    Objective "code": instruction cost first, with fact gaps as a tie-breaker. Use after reviewing
+    facts when frame size or literal-pool multiplicity is an allocation consequence."""
     if not n.get("ok"):
         return (9999, 9999, 9999, 9999)
     k = key_of(n)
@@ -493,6 +495,8 @@ def rank(n):
     if n.get("match"):
         return (0, 0, 0, 0)
     mode = OBJECTIVE["mode"]
+    if mode == "code":
+        return (0, cost, k[0], k[1])
     if mode == "rotation" and n.get("rot"):
         r = n["rot"]  # [diff after the best single shift, K, D]
         return (k[0], r[0], r[2] if r[0] == 0 else 99, cost)
@@ -677,6 +681,8 @@ def cmd_expand(a):
 
 def cmd_run(a):
     w = Work(a.f)
+    if a.objective:
+        OBJECTIVE["mode"] = a.objective
     starts = [w.node(n) for n in a.nodes] if a.nodes else w.best(a.width)
     if isinstance(starts, dict):
         starts = [starts]
@@ -1022,8 +1028,9 @@ def main():
     p.add_argument("--slack", type=int, help="explore children up to this much worse (shape+diff) than the "
                    "best (default max(4, diff/8))")
     p.add_argument("--depth", type=int, default=6, help="moves stacked on a node at most")
-    p.add_argument("--objective", choices=["rotation", "block"], help="rotation: rank by the reload spill "
-                   "shift still needed (AGBCC_SPILL=K:D); block: by one ROM block's cost (--block)")
+    p.add_argument("--objective", choices=["rotation", "block", "code"], help="rotation: rank by the reload spill "
+                   "shift still needed (AGBCC_SPILL=K:D); block: by one ROM block's cost (--block); "
+                   "code: instruction cost before reviewed fact gaps (e.g. allocation-dependent frames)")
     p.add_argument("--rot-max", type=int, help="rotation: test shifts on children with at most this diff")
     p.add_argument("--block", type=int, help="work on one ROM block (its number in the block map): moves only on "
                    "the C lines that produce it, ranked by its own cost first")

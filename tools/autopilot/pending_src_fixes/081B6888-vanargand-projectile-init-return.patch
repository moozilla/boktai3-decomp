081B6888 vanargand-projectile-init-return

Collider_SetAttackProperties returns by popping LR into r0.

The explicit form changed the ROM bytes. The guarded form passed the unit ROM check.

--- a/src/bosses/vanargand/vanargand_projectiles.c
+++ b/src/bosses/vanargand/vanargand_projectiles.c
@@ -104,4 +104,7 @@
     Collider_SetCallback(collider, VanargandProjectile_IgnoreContact, projectile);
     Collider_SetAttackProperties(collider, pool->attack, 30, 16, 0, 15);
+#ifdef UBFIX
+    return 0x081B69BF; // preserve the inherited GBA return value
+#endif
 }
 

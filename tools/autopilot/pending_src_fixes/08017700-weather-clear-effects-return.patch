08017700 weather-clear-effects-return

The loop preserves the incoming r0 if all slots are empty. The last
Effect_Remove returns through r0, leaving its Thumb return address.

The explicit form changed the ROM bytes. The guarded form passed the unit ROM check.

--- a/src/effects/weather/Weather_ClearEffects.c
+++ b/src/effects/weather/Weather_ClearEffects.c
@@ -6,4 +6,7 @@
     s32 i = 0x1f;
     u8 *q;
+#ifdef UBFIX
+    u32 result = (u32)p;
+#endif
     do {
         q = e + 0x14;
@@ -11,7 +14,13 @@
             Effect_Remove(q);
             *e = 0;
+#ifdef UBFIX
+            result = 0x0801771D;
+#endif
         }
         i--;
         e += 0x3c;
     } while (i >= 0);
+#ifdef UBFIX
+    return result; // original r0 follows the final removal
+#endif
 }

08017730 weather-particle-update-return

The loop keeps its initial weather pointer in r0 until a timer selects
a tile frame or removes a drop. Both calls return through r0.
The last of those Thumb return addresses survives subsequent stores.

The explicit form changed the ROM bytes. The guarded form passed the unit ROM check.

--- a/src/effects/weather/sub_08017730.c
+++ b/src/effects/weather/sub_08017730.c
@@ -22,4 +22,7 @@
     struct Drop *d = p->drops;
     int i;
+#ifdef UBFIX
+    int result = (int)p;
+#endif
     for (i = 31; i >= 0; i--, d++) {
         struct Sprite *s = &d->sprite;
@@ -32,4 +35,7 @@
                         d->state = 1;
                         SpriteDrawable_SelectTileFrame(s, p->resource, 31);
+#ifdef UBFIX
+                        result = 0x08017785;
+#endif
                         d->timer = 0;
                     }
@@ -38,4 +44,7 @@
                     if (d->timer > 2) {
                         Effect_Remove(s);
+#ifdef UBFIX
+                        result = 0x08017795;
+#endif
                         d->active = 0;
                     }
@@ -45,3 +54,6 @@
         }
     }
+#ifdef UBFIX
+    return result; // r0 keeps the callback link or initial owner
+#endif
 }

08018664 palette-blend-script-return

At 0801879A Script_GetKeywordValue returns the full W value in r0.
The following stores use r1 and r2, leaving r0 live for the VM.

The explicit form changed the ROM bytes. The guarded form passed the unit ROM check.

--- a/src/effects/palette/palette_cycle.c
+++ b/src/effects/palette/palette_cycle.c
@@ -192,5 +192,14 @@
     entry->length[1] = Script_GetKeywordValue('D', 10);
     entry->hold[0] = Script_GetKeywordValue('w', 0);
+#ifdef UBFIX
+    {
+        s32 hold = Script_GetKeywordValue('W', 0);
+        entry->hold[1] = hold;
+        cycle->entryCount++;
+        return hold;
+    }
+#else
     entry->hold[1] = Script_GetKeywordValue('W', 0);
     cycle->entryCount++;
-}
+#endif
+}

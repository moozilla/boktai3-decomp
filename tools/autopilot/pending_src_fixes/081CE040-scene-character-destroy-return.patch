081CE040 scene-character-destroy-return

The ROM leaves the result of its last call, SceneMessages_UnregisterReceiver, in r0.

The explicit form passed the unit ROM check.

--- a/src/fn/sub_081CE040.c
+++ b/src/fn/sub_081CE040.c
@@ -1,9 +1,9 @@
 #include "global.h"
 void ParticlePool_Destroy(u32);
-void SceneMessages_UnregisterReceiver(u8 *);
+s32 SceneMessages_UnregisterReceiver(u8 *);
 s32 SceneCharacter_OnDestroy(u8 *a, u8 *b)
 {
     if (b[1] == 0x1d)
         ParticlePool_Destroy(*(u32 *)(b + 0x20));
-    SceneMessages_UnregisterReceiver(b + 0x168);
+    return SceneMessages_UnregisterReceiver(b + 0x168);
 }

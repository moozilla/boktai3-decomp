+/* Variable names of pseudos, keyed by the REG rtx (which inlining copies).  */
+#define AGBCC_NAMES 65536
+static rtx agbcc_name_key[AGBCC_NAMES];
+static char *agbcc_name_val[AGBCC_NAMES];
+void
+agbcc_name_set (x, name)
+     rtx x;
+     char *name;
+{
+  unsigned long h = ((unsigned long) x >> 4) & (AGBCC_NAMES - 1);
+  int n;
+  for (n = 0; n < AGBCC_NAMES; n++, h = (h + 1) & (AGBCC_NAMES - 1))
+    if (agbcc_name_key[h] == 0 || agbcc_name_key[h] == x)
+      {
+	agbcc_name_key[h] = x;
+	agbcc_name_val[h] = name;
+	return;
+      }
+}
+char *
+agbcc_name_get (x)
+     rtx x;
+{
+  unsigned long h = ((unsigned long) x >> 4) & (AGBCC_NAMES - 1);
+  int n;
+  for (n = 0; n < AGBCC_NAMES; n++, h = (h + 1) & (AGBCC_NAMES - 1))
+    {
+      if (agbcc_name_key[h] == x)
+	return agbcc_name_val[h];
+      if (agbcc_name_key[h] == 0)
+	return "-";
+    }
+  return "-";
+}
+
+/* "=value" for a constant rtx, else 0.  */
+char *
+agbcc_const_label (x)
+     rtx x;
+{
+  static char bufs[8][128];
+  static int which;
+  char *buf;
+  if (x == 0)
+    return 0;
+  buf = bufs[which++ & 7];
+  switch (GET_CODE (x))
+    {
+    case CONST_INT:
+      sprintf (buf, "=%ld", (long) INTVAL (x));
+      return buf;
+    case SYMBOL_REF:
+      sprintf (buf, "=%s", XSTR (x, 0));
+      return buf;
+    case CONST:
+      if (GET_CODE (XEXP (x, 0)) == PLUS
+	  && GET_CODE (XEXP (XEXP (x, 0), 0)) == SYMBOL_REF
+	  && GET_CODE (XEXP (XEXP (x, 0), 1)) == CONST_INT)
+	{
+	  sprintf (buf, "=%s+%ld", XSTR (XEXP (XEXP (x, 0), 0), 0),
+		   (long) INTVAL (XEXP (XEXP (x, 0), 1)));
+	  return buf;
+	}
+      return 0;
+    default:
+      return 0;
+    }
+}
+
+/* The variable name of pseudo REGNO, or "=constant" if it holds one.  */
+char *
+agbcc_pseudo_label (regno)
+     int regno;
+{
+  char *name = agbcc_name_get (regno_reg_rtx[regno]);
+  rtx insn;
+  if (name && strcmp (name, "-") != 0)
+    return name;
+  for (insn = get_insns (); insn; insn = NEXT_INSN (insn))
+    {
+      rtx set, note;
+      char *c;
+      if (GET_RTX_CLASS (GET_CODE (insn)) != 'i')
+	continue;
+      set = single_set (insn);
+      if (! set || GET_CODE (SET_DEST (set)) != REG || REGNO (SET_DEST (set)) != regno)
+	continue;
+      note = find_reg_note (insn, REG_EQUIV, NULL_RTX);
+      if (! note)
+	note = find_reg_note (insn, REG_EQUAL, NULL_RTX);
+      if (note && (c = agbcc_const_label (XEXP (note, 0))) != 0)
+	return c;
+      if ((c = agbcc_const_label (SET_SRC (set))) != 0)
+	return c;
+      return "-";
+    }
+  return "-";
+}
+
+void
+agbcc_instr_init ()
+{
+  static int done;
+  char *e;
+  int i;
+  if (done)
+    return;
+  done = 1;
+  for (i = 0; i < AGBCC_MAXREG; i++)
+    agbcc_force[i] = -1;
+  if ((e = getenv ("AGBCC_PRI")) != 0)
+    while (*e)
+      {
+	int r, d, n = 0;
+	if (sscanf (e, "%d:%d%n", &r, &d, &n) < 2 || n == 0)
+	  break;
+	if (r >= 0 && r < AGBCC_MAXREG)
+	  agbcc_pri_delta[r] += d;
+	e += n;
+	if (*e == ',')
+	  e++;
+      }
+  if ((e = getenv ("AGBCC_FORCE")) != 0)
+    while (*e)
+      {
+	int r, h, n = 0;
+	if (sscanf (e, "%d:%d%n", &r, &h, &n) < 2 || n == 0)
+	  break;
+	if (r >= 0 && r < AGBCC_MAXREG)
+	  agbcc_force[r] = h;
+	e += n;
+	if (*e == ',')
+	  e++;
+      }
+  if ((e = getenv ("AGBCC_DUMPPRI")) != 0)
+    agbcc_dump = fopen (e, "a");
+}

+/* Instrumentation for tools/rasolve.py (Boktai 3 decomp). Never used by the
+   real build: this copy of agbcc lives in build/agbcc-instr.
+     AGBCC_PRI="reg:delta,..."   add DELTA to pseudo REG's allocation priority
+     AGBCC_FORCE="reg:hard,..."  allocate pseudo REG to hard register HARD
+     AGBCC_DUMPPRI=FILE          append each pseudo's priority and register  */
+#define AGBCC_MAXREG 40000
+int agbcc_pri_delta[AGBCC_MAXREG];
+int agbcc_force[AGBCC_MAXREG];

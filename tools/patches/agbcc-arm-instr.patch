+static int agbcc_instr_done;
+void
+agbcc_instr_reset ()
+{
+  int i;
+  agbcc_instr_done = 0;
+  for (i = 0; i < AGBCC_MAXREG; i++)
+    agbcc_pri_delta[i] = 0;
+  if (agbcc_dump)
+    fclose (agbcc_dump);
+  agbcc_dump = 0;
+}
+
+void
+agbcc_instr_init ()
+{
+#define done agbcc_instr_done
+  char *e;
+  int i;
+  if (done)
+    return;
+  done = 1;
+  for (i = 0; i < AGBCC_MAXREG; i++)
+    agbcc_force[i] = -1;
+  if ((e = getenv ("AGBCC_PRI")) != 0)
+    while (*e)
+      {
+	int r, d, n = 0;
+	if (sscanf (e, "%d:%d%n", &r, &d, &n) < 2 || n == 0)
+	  break;
+	if (r >= 0 && r < AGBCC_MAXREG)
+	  agbcc_pri_delta[r] += d;
+	e += n;
+	if (*e == ',')
+	  e++;
+      }
+  if ((e = getenv ("AGBCC_FORCE")) != 0)
+    while (*e)
+      {
+	int r, h, n = 0;
+	if (sscanf (e, "%d:%d%n", &r, &h, &n) < 2 || n == 0)
+	  break;
+	if (r >= 0 && r < AGBCC_MAXREG)
+	  agbcc_force[r] = h;
+	e += n;
+	if (*e == ',')
+	  e++;
+      }
+  if ((e = getenv ("AGBCC_DUMPPRI")) != 0)
+    agbcc_dump = fopen (e, "a");
+}

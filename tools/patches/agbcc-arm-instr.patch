+agbcc_name_set (x, name)
+     rtx x;
+     char *name;
+{
+  unsigned long h = ((unsigned long) x >> 4) & (AGBCC_NAMES - 1);
+  int n;
+  if (getenv ("AGBCC_NAMEDBG"))
+    fprintf (stderr, "set %p %d %s\n", (void *) x, REGNO (x), name);
+  for (n = 0; n < AGBCC_NAMES; n++, h = (h + 1) & (AGBCC_NAMES - 1))
+    if (agbcc_name_key[h] == 0 || agbcc_name_key[h] == x)
+      {
+	agbcc_name_key[h] = x;
+	agbcc_name_val[h] = name;
+	return;
+      }
+}
+char *
+agbcc_name_get (x)
+     rtx x;
+{
+  unsigned long h = ((unsigned long) x >> 4) & (AGBCC_NAMES - 1);
+  int n;
+  for (n = 0; n < AGBCC_NAMES; n++, h = (h + 1) & (AGBCC_NAMES - 1))
+    {
+      if (agbcc_name_key[h] == x)
+	return agbcc_name_val[h];
+      if (agbcc_name_key[h] == 0)
+	return "-";
+    }
+  return "-";
+}
+
+/* "=value" for a constant rtx, else 0.  */
+char *
+agbcc_const_label (x)
+     rtx x;
+{
+  static char bufs[8][128];
+  static int which;
+  char *buf;
+  if (x == 0)
+    return 0;
+  buf = bufs[which++ & 7];
+  switch (GET_CODE (x))
+    {
+    case CONST_INT:
+      sprintf (buf, "=%ld", (long) INTVAL (x));
+      return buf;
+    case SYMBOL_REF:
+      sprintf (buf, "=%s", XSTR (x, 0));
+      return buf;
+    case CONST:
+      if (GET_CODE (XEXP (x, 0)) == PLUS
+	  && GET_CODE (XEXP (XEXP (x, 0), 0)) == SYMBOL_REF
+	  && GET_CODE (XEXP (XEXP (x, 0), 1)) == CONST_INT)
+	{
+	  sprintf (buf, "=%s+%ld", XSTR (XEXP (XEXP (x, 0), 0), 0),
+		   (long) INTVAL (XEXP (XEXP (x, 0), 1)));
+	  return buf;
+	}
+      return 0;
+    default:
+      return 0;
+    }
+}
+
+static char *agbcc_pseudo_base_label ();
+static char **agbcc_label_cache;
+static char *
+agbcc_pseudo_base_label_cached (k)
+     int k;
+{
+  static char buf[256];
+  char *l = agbcc_label_cache[k], *h;
+  strncpy (buf, l, sizeof buf - 1);
+  buf[sizeof buf - 1] = 0;
+  h = strrchr (buf, '#');
+  if (h && h != buf)
+    *h = 0;
+  return buf;
+}
+
+/* The label of pseudo REGNO: its variable name or "=constant", with "#N"
+   when it is the N-th later pseudo (in creation order) with that label.
+   Cached per function.  */
+static int agbcc_label_n;
+static rtx agbcc_label_first;
+char *
+agbcc_pseudo_label (regno)
+     int regno;
+{
+  if (agbcc_label_first != get_insns () || regno >= agbcc_label_n || ! agbcc_label_cache)
+    {
+      int r, n = max_reg_num ();
+      if (agbcc_label_cache)
+	free (agbcc_label_cache);
+      agbcc_label_cache = (char **) xmalloc ((n + 1) * sizeof (char *));
+      for (r = 0; r < n; r++)
+	{
+	  char *base = r < FIRST_PSEUDO_REGISTER ? "-" : agbcc_pseudo_base_label (r);
+	  int k, same = 0;
+	  agbcc_label_cache[r] = base;
+	  if (! strcmp (base, "-"))
+	    continue;
+	  for (k = FIRST_PSEUDO_REGISTER; k < r; k++)
+	    if (! strcmp (agbcc_pseudo_base_label_cached (k), base))
+	      same++;
+	  if (same)
+	    {
+	      char *b = (char *) xmalloc (strlen (base) + 16);
+	      sprintf (b, "%s#%d", base, same);
+	      agbcc_label_cache[r] = b;
+	    }
+	  else
+	    agbcc_label_cache[r] = xstrdup (base);
+	}
+      agbcc_label_n = n;
+      agbcc_label_first = get_insns ();
+    }
+  return regno < agbcc_label_n ? agbcc_label_cache[regno] : "-";
+}
+
+/* The variable name of pseudo REGNO, or "=constant" if it holds one.  */
+static char *
+agbcc_pseudo_base_label (regno)
+     int regno;
+{
+  char *name = agbcc_name_get (regno_reg_rtx[regno]);
+  rtx insn;
+  if (name && strcmp (name, "-") != 0)
+    return name;
+  for (insn = get_insns (); insn; insn = NEXT_INSN (insn))
+    {
+      rtx set, note;
+      char *c;
+      if (GET_RTX_CLASS (GET_CODE (insn)) != 'i')
+	continue;
+      set = single_set (insn);
+      if (! set || GET_CODE (SET_DEST (set)) != REG || REGNO (SET_DEST (set)) != regno)
+	continue;
+      note = find_reg_note (insn, REG_EQUIV, NULL_RTX);
+      if (! note)
+	note = find_reg_note (insn, REG_EQUAL, NULL_RTX);
+      if (note && (c = agbcc_const_label (XEXP (note, 0))) != 0)
+	return c;
+      if ((c = agbcc_const_label (SET_SRC (set))) != 0)
+	return c;
+      return "-";
+    }
+  return "-";
+}
+
+/* AGBCC_PRI_LABEL="label:delta,...": like AGBCC_PRI, but for the pseudos
+   whose agbcc_pseudo_label is LABEL (a variable name or "=constant"), so a
+   change can be named across different sources.  */
+static int agbcc_label_delta[AGBCC_MAXREG];
+char *agbcc_pseudo_label ();
+static char agbcc_label_forced[AGBCC_MAXREG];
+static void agbcc_apply_force_labels ();
+static void
+agbcc_apply_labels ()
+{
+  char *e = getenv ("AGBCC_PRI_LABEL");
+  int r, nregs = max_reg_num ();
+  agbcc_apply_force_labels ();
+  for (r = 0; r < AGBCC_MAXREG; r++)
+    {
+      agbcc_pri_delta[r] -= agbcc_label_delta[r];
+      agbcc_label_delta[r] = 0;
+    }
+  if (! e || ! *e)
+    return;
+  for (r = FIRST_PSEUDO_REGISTER; r < nregs && r < AGBCC_MAXREG; r++)
+    {
+      char *lab = agbcc_pseudo_label (r);
+      char *p = e;
+      if (! lab || ! strcmp (lab, "-"))
+	continue;
+      while (*p)
+	{
+	  char *comma = strchr (p, ',');
+	  char *colon;
+	  int len = comma ? comma - p : strlen (p);
+	  char item[256];
+	  if (len >= (int) sizeof item)
+	    len = sizeof item - 1;
+	  memcpy (item, p, len);
+	  item[len] = 0;
+	  colon = strrchr (item, ':');
+	  if (colon)
+	    {
+	      *colon = 0;
+	      if (! strcmp (item, lab))
+		{
+		  int d = atoi (colon + 1);
+		  agbcc_label_delta[r] += d;
+		  agbcc_pri_delta[r] += d;
+		}
+	    }
+	  if (! comma)
+	    break;
+	  p = comma + 1;
+	}
+    }
+}
+
+/* AGBCC_FORCE_LABEL="label:hard,...": like AGBCC_FORCE, by label.  */
+static void
+agbcc_apply_force_labels ()
+{
+  char *e = getenv ("AGBCC_FORCE_LABEL");
+  int r, nregs = max_reg_num ();
+  for (r = 0; r < AGBCC_MAXREG; r++)
+    if (agbcc_label_forced[r])
+      {
+	agbcc_force[r] = -1;
+	agbcc_label_forced[r] = 0;
+      }
+  if (! e || ! *e)
+    return;
+  for (r = FIRST_PSEUDO_REGISTER; r < nregs && r < AGBCC_MAXREG; r++)
+    {
+      char *lab = agbcc_pseudo_label (r);
+      char *p = e;
+      if (! lab || ! strcmp (lab, "-"))
+	continue;
+      while (*p)
+	{
+	  char *comma = strchr (p, ',');
+	  char item[256], *colon;
+	  int len = comma ? comma - p : strlen (p);
+	  if (len >= (int) sizeof item)
+	    len = sizeof item - 1;
+	  memcpy (item, p, len);
+	  item[len] = 0;
+	  colon = strrchr (item, ':');
+	  if (colon)
+	    {
+	      *colon = 0;
+	      if (! strcmp (item, lab))
+		{
+		  agbcc_force[r] = atoi (colon + 1);
+		  agbcc_label_forced[r] = 1;
+		}
+	    }
+	  if (! comma)
+	    break;
+	  p = comma + 1;
+	}
+    }
+}

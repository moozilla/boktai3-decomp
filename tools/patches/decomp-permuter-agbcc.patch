+++ b/src/agbcc_passes.py
@@ -0,0 +1,923 @@
+"""Randomization passes for agbcc (gcc 2.95) register allocation and scheduling.
+
+Each pass is a source change that has closed a match by hand in the Boktai 3
+decomp (docs/REGALLOC.md there). Unlike most upstream passes they keep the
+program's meaning, except perm_literal_address, which relies on the symbol
+address table that tools/permute.py writes into settings.toml.
+"""
+
+import copy
+from random import Random
+from typing import Dict, List, Optional, Set, Tuple
+
+from perm_pycparser import c_ast as ca
+
+from . import ast_util
+from .ast_util import Block, Indices, Statement
+from .ast_types import build_typemap, resolve_typedefs, set_decl_name
+from .randomizer import (
+    RandomizationFailure,
+    RANDOMIZATION_PASSES,
+    Region,
+    ensure,
+    random_bool,
+    random_weighted,
+    replace_subexprs,
+    visit_replace,
+)
+
+# Name -> address for perm_literal_address; set from settings.toml.
+SYMBOL_ADDRESSES: Dict[str, int] = {}
+
+MAX = 10**9
+
+INT_TYPES = [
+    ["s32"],
+    ["u32"],
+    ["s16"],
+    ["u16"],
+    ["u8"],
+    ["s8"],
+    ["int"],
+]
+
+
+# --- helpers ---------------------------------------------------------------
+
+
+def all_blocks(fn: ca.FuncDef) -> List[Tuple[Block, int]]:
+    """Every statement list in the function, with its loop depth."""
+    out: List[Tuple[Block, int]] = []
+
+    def rec(block: Block, depth: int) -> None:
+        out.append((block, depth))
+        for stmt in ast_util.get_block_stmts(block, False):
+            inner = depth + (1 if isinstance(stmt, (ca.For, ca.While, ca.DoWhile)) else 0)
+            ast_util.for_nested_blocks(stmt, lambda b: rec(b, inner))
+
+    rec(fn.body, 0)
+    return out
+
+
+def ids_in(node: Optional[ca.Node]) -> List[ca.ID]:
+    """Variable references (not struct field names) below node."""
+    found: List[ca.ID] = []
+    if node is None:
+        return found
+
+    class V(ca.NodeVisitor):
+        def visit_ID(self, n: ca.ID) -> None:
+            found.append(n)
+
+        def visit_StructRef(self, n: ca.StructRef) -> None:
+            self.visit(n.name)
+
+        def visit_FuncCall(self, n: ca.FuncCall) -> None:
+            if not isinstance(n.name, ca.ID):
+                self.visit(n.name)
+            if n.args:
+                self.visit(n.args)
+
+    V().visit(node)
+    return found
+
+
+def names_in(node: Optional[ca.Node]) -> Set[str]:
+    return {i.name for i in ids_in(node)}
+
+
+def written_names(node: ca.Node) -> Set[str]:
+    out: Set[str] = set()
+
+    class V(ca.NodeVisitor):
+        def visit_Assignment(self, n: ca.Assignment) -> None:
+            if isinstance(n.lvalue, ca.ID):
+                out.add(n.lvalue.name)
+            self.generic_visit(n)
+
+        def visit_UnaryOp(self, n: ca.UnaryOp) -> None:
+            if n.op in ("p++", "p--", "++", "--", "&") and isinstance(n.expr, ca.ID):
+                out.add(n.expr.name)  # & : may be written through the pointer
+            self.generic_visit(n)
+
+        def visit_Decl(self, n: ca.Decl) -> None:
+            if n.name:
+                out.add(n.name)
+            if n.init is not None:
+                self.visit(n.init)
+
+    V().visit(node)
+    return out
+
+
+def touches_memory(node: ca.Node, *, writes: bool) -> bool:
+    """Whether node reads (writes=False) or writes/calls (writes=True) memory."""
+    found = False
+
+    class V(ca.NodeVisitor):
+        def visit_FuncCall(self, n: ca.FuncCall) -> None:
+            nonlocal found
+            found = True
+
+        def visit_Assignment(self, n: ca.Assignment) -> None:
+            nonlocal found
+            if writes and not isinstance(n.lvalue, ca.ID):
+                found = True
+            self.generic_visit(n)
+
+        def visit_UnaryOp(self, n: ca.UnaryOp) -> None:
+            nonlocal found
+            if writes and n.op in ("p++", "p--", "++", "--") and not isinstance(n.expr, ca.ID):
+                found = True
+            if not writes and n.op == "*":
+                found = True
+            self.generic_visit(n)
+
+        def visit_StructRef(self, n: ca.StructRef) -> None:
+            nonlocal found
+            if not writes:
+                found = True
+            self.generic_visit(n)
+
+        def visit_ArrayRef(self, n: ca.ArrayRef) -> None:
+            nonlocal found
+            if not writes:
+                found = True
+            self.generic_visit(n)
+
+        def visit_Asm(self, n: ca.Asm) -> None:
+            nonlocal found
+            found = True
+
+    V().visit(node)
+    return found
+
+
+def has_jumps(node: ca.Node) -> bool:
+    found = False
+
+    class V(ca.NodeVisitor):
+        def visit_Break(self, n: ca.Node) -> None:
+            nonlocal found
+            found = True
+
+        visit_Continue = visit_Goto = visit_Label = visit_Break
+
+    V().visit(node)
+    return found
+
+
+def has_own_continue(body: ca.Node) -> bool:
+    """A `continue` that belongs to this loop (not to a nested one)."""
+    found = False
+
+    class V(ca.NodeVisitor):
+        def visit_Continue(self, n: ca.Node) -> None:
+            nonlocal found
+            found = True
+
+        def visit_For(self, n: ca.Node) -> None:
+            pass
+
+        visit_While = visit_DoWhile = visit_For
+
+    V().visit(body)
+    return found
+
+
+def local_decls(fn: ca.FuncDef) -> Dict[str, ca.Decl]:
+    out: Dict[str, ca.Decl] = {}
+
+    class V(ca.NodeVisitor):
+        def visit_Decl(self, n: ca.Decl) -> None:
+            if n.name and not isinstance(n.type, ca.FuncDecl):
+                out[n.name] = n
+            if n.init is not None:
+                self.visit(n.init)
+
+    V().visit(fn.body)
+    assert isinstance(fn.decl.type, ca.FuncDecl)
+    if fn.decl.type.args:
+        for p in fn.decl.type.args.params:
+            if isinstance(p, ca.Decl) and p.name:
+                out[p.name] = p
+    return out
+
+
+def address_taken(fn: ca.FuncDef) -> Set[str]:
+    out: Set[str] = set()
+
+    class V(ca.NodeVisitor):
+        def visit_UnaryOp(self, n: ca.UnaryOp) -> None:
+            if n.op == "&" and isinstance(n.expr, ca.ID):
+                out.add(n.expr.name)
+            self.generic_visit(n)
+
+    V().visit(fn.body)
+    return out
+
+
+def is_scalar_decl(decl: ca.Decl) -> bool:
+    return isinstance(decl.type, (ca.TypeDecl, ca.PtrDecl)) and not (
+        isinstance(decl.type, ca.TypeDecl)
+        and isinstance(decl.type.type, (ca.Struct, ca.Union))
+    ) and "volatile" not in (decl.quals or [])
+
+
+def new_name(fn: ca.FuncDef, ast: ca.FileAST, base: str) -> str:
+    used = set(local_decls(fn)) | {
+        item.name for item in ast.ext if isinstance(item, ca.Decl) and item.name
+    } | {item.decl.name for item in ast.ext if isinstance(item, ca.FuncDef)}
+    i = 2
+    while f"{base}{i}" in used:
+        i += 1
+    return f"{base}{i}"
+
+
+def insert_local_decl(fn: ca.FuncDef, decl: ca.Decl, random: Random) -> None:
+    items = ast_util.get_block_stmts(fn.body, True)
+    n = 0
+    while n < len(items) and isinstance(items[n], ca.Decl):
+        n += 1
+    items.insert(random.randint(0, n), decl)
+
+
+def int_decl(name: str, type_names: List[str], init: Optional[ca.Node]) -> ca.Decl:
+    tp = ca.TypeDecl(declname=name, quals=[], align=[], type=ca.IdentifierType(names=type_names))
+    return ca.Decl(name=name, quals=[], align=[], storage=[], funcspec=[],
+                   gcc_attributes=[], type=tp, init=init, bitsize=None, asmlabel=None)
+
+
+def stmt_index_in_region(block: Block, region: Region) -> List[int]:
+    return [i for i, s in enumerate(ast_util.get_block_stmts(block, False)) if region.contains_node(s)]
+
+
+# --- passes ----------------------------------------------------------------
+
+
+def perm_loop_form(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Rewrite a loop in another form: for <-> while, or a while into an entry
+    test plus do/while (and back). Loop shape decides agbcc's loop
+    reversal, the exit test's place and which values stay in registers."""
+    cands: List[Tuple[Block, int]] = []
+    for block, _ in all_blocks(fn):
+        for i, stmt in enumerate(ast_util.get_block_stmts(block, False)):
+            if not region.contains_pre(stmt):
+                continue
+            if isinstance(stmt, (ca.For, ca.While)):
+                cands.append((block, i))
+            elif (
+                isinstance(stmt, ca.If)
+                and stmt.iffalse is None
+                and isinstance(stmt.iftrue, ca.Compound)
+                and len(stmt.iftrue.block_items or []) == 1
+                and isinstance(stmt.iftrue.block_items[0], ca.DoWhile)
+                and ast_util.equal_ast(stmt.cond, stmt.iftrue.block_items[0].cond)
+            ):
+                cands.append((block, i))
+    ensure(cands)
+    block, i = random.choice(cands)
+    stmts = ast_util.get_block_stmts(block, True)
+    loop = stmts[i]
+
+    def body_items(stmt: Statement) -> List[Statement]:
+        if isinstance(stmt, ca.Compound):
+            return list(stmt.block_items or [])
+        return [stmt]
+
+    if isinstance(loop, ca.If):
+        dw = loop.iftrue.block_items[0]
+        stmts[i] = ca.While(dw.cond, dw.stmt)
+        return
+
+    if isinstance(loop, ca.For):
+        ensure(not isinstance(loop.init, ca.DeclList))
+        ensure(loop.next is None or not has_own_continue(loop.stmt))
+        cond = loop.cond if loop.cond is not None else ca.Constant("int", "1")
+        body = body_items(loop.stmt)
+        if loop.next is not None:
+            nxt = loop.next
+            if isinstance(nxt, ca.ExprList):
+                body += list(nxt.exprs)
+            else:
+                body.append(nxt)
+        pre = []
+        if loop.init is not None:
+            init = loop.init
+            pre = list(init.exprs) if isinstance(init, ca.ExprList) else [init]
+        if loop.cond is not None and random_bool(random, 0.5):
+            ensure(not ast_util.is_effectful(cond))
+            new: Statement = ca.If(
+                cond,
+                ca.Compound([ca.DoWhile(copy.deepcopy(cond), ca.Compound(body))]),
+                None,
+            )
+        else:
+            new = ca.While(cond, ca.Compound(body))
+        stmts[i : i + 1] = pre + [new]
+        return
+
+    assert isinstance(loop, ca.While)
+    body = body_items(loop.stmt)
+    choice = random.randint(0, 1)
+    if choice == 0:
+        ensure(not ast_util.is_effectful(loop.cond))
+        stmts[i] = ca.If(
+            loop.cond,
+            ca.Compound([ca.DoWhile(copy.deepcopy(loop.cond), ca.Compound(body))]),
+            None,
+        )
+        return
+    # while -> for, folding a preceding assignment and a final step in.
+    init = None
+    if i > 0 and isinstance(stmts[i - 1], (ca.Assignment, ca.UnaryOp)) and random_bool(random, 0.7):
+        init = stmts[i - 1]
+    nxt = None
+    if (
+        body
+        and isinstance(body[-1], (ca.Assignment, ca.UnaryOp))
+        and not has_own_continue(ca.Compound(body))
+        and random_bool(random, 0.7)
+    ):
+        nxt = body.pop()
+    ensure(init is not None or nxt is not None)
+    new_for = ca.For(init, loop.cond, nxt, ca.Compound(body))
+    if init is not None:
+        stmts[i - 1 : i + 1] = [new_for]
+    else:
+        stmts[i] = new_for
+
+
+def perm_addr_deref(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Write a variable reference x as *&x. For a global or an array this
+    stops CSE from treating its address as a known constant (the address is
+    then not hoisted into a callee-saved register)."""
+    locals_ = local_decls(fn)
+    cands: List[ca.ID] = []
+
+    def collect(node: ca.Node, is_expr: bool) -> None:
+        if isinstance(node, ca.ID) and region.contains_node(node):
+            decl = locals_.get(node.name)
+            if decl is not None and "register" in (decl.storage or []):
+                return
+            cands.append(node)
+        return None
+
+    visit_replace(fn.body, collect)
+    typemap = build_typemap(ast, fn)
+    cands = [
+        c
+        for c in cands
+        if c.name in typemap.var_types
+        and not isinstance(resolve_typedefs(typemap.var_types[c.name], typemap), ca.FuncDecl)
+    ]
+    ensure(cands)
+    # Globals and arrays are where this has mattered; locals become addressable.
+    weighted = [(c, 1.0 if c.name not in locals_ else 0.15) for c in cands]
+    target = random_weighted(random, weighted)
+
+    def repl(node: ca.Node, is_expr: bool) -> Optional[ca.Node]:
+        if node is target:
+            return ca.UnaryOp("*", ca.UnaryOp("&", ca.ID(target.name)))
+        return None
+
+    visit_replace(fn.body, repl)
+
+
+def _typename_for(tp: ca.Node) -> ca.Typename:
+    tp = copy.deepcopy(tp)
+    inner = tp
+    while not isinstance(inner, ca.TypeDecl):
+        inner = inner.type
+    inner.declname = None
+    return ca.Typename(name=None, quals=[], align=[], gcc_attributes=[], type=tp)
+
+
+def perm_literal_address(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Refer to a global through its literal address, (*(T *)0x0203B400),
+    instead of its symbol. The constant is then loaded by reload, which
+    advances reload's spill-register rotation (REGALLOC.md, sub_08160EA4)."""
+    locals_ = local_decls(fn)
+    typemap = build_typemap(ast, fn)
+
+    def address(name: str) -> Optional[int]:
+        if name in SYMBOL_ADDRESSES:
+            return SYMBOL_ADDRESSES[name]
+        if name.startswith("gUnk_") and len(name) == 13:
+            try:
+                return int(name[5:], 16)
+            except ValueError:
+                return None
+        return None
+
+    cands: List[ca.ID] = []
+
+    def collect(node: ca.Node, is_expr: bool) -> None:
+        if (
+            isinstance(node, ca.ID)
+            and node.name not in locals_
+            and region.contains_node(node)
+            and address(node.name) is not None
+            and node.name in typemap.var_types
+        ):
+            cands.append(node)
+        return None
+
+    visit_replace(fn.body, collect)
+    ensure(cands)
+    target = random.choice(cands)
+    tp = typemap.var_types[target.name]
+    ensure(not isinstance(tp, ca.FuncDecl))
+    addr = ca.Constant("int", f"0x{address(target.name):08X}")
+    if isinstance(tp, ca.ArrayDecl):
+        new: ca.Node = ca.Cast(_typename_for(ca.PtrDecl(quals=[], type=tp.type)), addr)
+    else:
+        new = ca.UnaryOp("*", ca.Cast(_typename_for(ca.PtrDecl(quals=[], type=tp)), addr))
+
+    def repl(node: ca.Node, is_expr: bool) -> Optional[ca.Node]:
+        return new if node is target else None
+
+    visit_replace(fn.body, repl)
+
+
+def perm_move_to_use(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Move an assignment `x = e;` down to just before the first statement
+    that uses x, or up to just after the last statement it depends on. agbcc
+    emits statements in source order, and the distance sets the lifetime
+    that local-alloc's priority divides by."""
+    locals_ = local_decls(fn)
+    taken = address_taken(fn)
+    moves: List[Tuple[Block, int, int]] = []
+    for block, _ in all_blocks(fn):
+        stmts = ast_util.get_block_stmts(block, False)
+        first = 0
+        while first < len(stmts) and isinstance(stmts[first], ca.Decl):
+            first += 1
+        for i in range(first, len(stmts)):
+            s = stmts[i]
+            if not (
+                isinstance(s, ca.Assignment)
+                and isinstance(s.lvalue, ca.ID)
+                and s.lvalue.name in locals_
+                and s.lvalue.name not in taken
+                and region.contains_node(s)
+            ):
+                continue
+            x = s.lvalue.name
+            reads = names_in(s.rvalue) | ({x} if s.op != "=" else set())
+            mem_read = touches_memory(s.rvalue, writes=False) or bool(reads - set(locals_))
+            effectful = ast_util.is_effectful(s.rvalue) or touches_memory(s.rvalue, writes=True)
+
+            def blocks_move(t: Statement) -> bool:
+                if isinstance(t, (ca.Label, ca.Case, ca.Default, ca.Pragma)) or has_jumps(t):
+                    return True
+                if x in names_in(t) or x in written_names(t):
+                    return True
+                if reads & written_names(t):
+                    return True
+                if (mem_read or effectful) and touches_memory(t, writes=True):
+                    return True
+                if effectful and touches_memory(t, writes=False):
+                    return True
+                return False
+
+            j = i + 1
+            while j < len(stmts) and not blocks_move(stmts[j]):
+                j += 1
+            if j > i + 1:
+                moves.append((block, i, j))  # insert before stmts[j]
+            k = i - 1
+            while k >= first and not blocks_move(stmts[k]):
+                k -= 1
+            if k + 1 < i:
+                moves.append((block, i, k + 1))
+    ensure(moves)
+    block, i, to = random.choice(moves)
+    stmts = ast_util.get_block_stmts(block, True)
+    s = stmts.pop(i)
+    if to > i:
+        to -= 1
+    stmts.insert(to, s)
+
+
+def perm_split_var(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Give one assignment of a reused variable its own variable, up to the
+    next assignment that replaces it. Several lifetimes in one pseudo send it
+    to global allocation; one per value keeps them local (or the reverse,
+    which perm_remove_var covers)."""
+    locals_ = local_decls(fn)
+    taken = address_taken(fn)
+    writes_count: Dict[str, int] = {}
+    for name in locals_:
+        writes_count[name] = 0
+
+    class Count(ca.NodeVisitor):
+        def visit_Assignment(self, n: ca.Assignment) -> None:
+            if isinstance(n.lvalue, ca.ID) and n.lvalue.name in writes_count:
+                writes_count[n.lvalue.name] += 1
+            self.generic_visit(n)
+
+    Count().visit(fn.body)
+    order: Dict[int, int] = {}
+    cands: List[Tuple[Block, int, int, bool]] = []
+    for block, depth in all_blocks(fn):
+        stmts = ast_util.get_block_stmts(block, False)
+        for i, s in enumerate(stmts):
+            if not (
+                isinstance(s, ca.Assignment)
+                and s.op == "="
+                and isinstance(s.lvalue, ca.ID)
+                and region.contains_node(s)
+            ):
+                continue
+            x = s.lvalue.name
+            decl = locals_.get(x)
+            if decl is None or x in taken or not is_scalar_decl(decl):
+                continue
+            if writes_count.get(x, 0) + (1 if decl.init is not None else 0) < 2:
+                continue
+            j = i + 1
+            while j < len(stmts) and not (
+                isinstance(stmts[j], ca.Assignment)
+                and isinstance(stmts[j].lvalue, ca.ID)
+                and stmts[j].lvalue.name == x
+            ):
+                j += 1
+            rng = stmts[i + 1 : j]
+            if any(has_jumps(t) or isinstance(t, (ca.Case, ca.Default)) for t in rng):
+                continue
+            if j == len(stmts):
+                # No later assignment in this block: only when nothing after
+                # the block can see the value.
+                if depth > 0 or not isinstance(block, ca.Compound):
+                    continue
+                cands.append((block, i, j, False))
+            else:
+                cands.append((block, i, j, True))
+    ensure(cands)
+    block, i, j, killed = random.choice(cands)
+    stmts = ast_util.get_block_stmts(block, True)
+    s = stmts[i]
+    x = s.lvalue.name
+    if not killed:
+        # Every use of x after the block must be inside it.
+        end = indices.ends.get(block)
+        ensure(end is not None)
+
+        bad = False
+
+        class After(ca.NodeVisitor):
+            def visit_ID(self, n: ca.ID) -> None:
+                nonlocal bad
+                if n.name == x and indices.starts.get(n, 0) > end:
+                    bad = True
+
+            def visit_StructRef(self, n: ca.StructRef) -> None:
+                self.visit(n.name)
+
+        After().visit(fn.body)
+        ensure(not bad)
+        # nor jump back from after the block to where x is still read
+        labels: Dict[str, int] = {}
+        gotos: List[Tuple[str, int]] = []
+
+        class Jumps(ca.NodeVisitor):
+            def visit_Label(self, n: ca.Label) -> None:
+                labels[n.name] = indices.starts.get(n, 0)
+                self.generic_visit(n)
+
+            def visit_Goto(self, n: ca.Goto) -> None:
+                gotos.append((n.name, indices.starts.get(n, 0)))
+
+        Jumps().visit(fn.body)
+        here = indices.starts.get(s, 0)
+        ensure(not any(at > here and labels.get(name, MAX) < here for name, at in gotos))
+    x2 = new_name(fn, ast, x + "_")
+
+    def rename(node: ca.Node, is_expr: bool) -> Optional[ca.Node]:
+        if isinstance(node, ca.ID) and node.name == x:
+            return ca.ID(x2)
+        return None
+
+    s.lvalue = ca.ID(x2)
+    for t in stmts[i + 1 : j]:
+        visit_replace(t, rename)
+    if killed:
+        visit_replace(stmts[j].rvalue, rename)
+    decl = copy.deepcopy(locals_[x])
+    decl.init = None
+    decl.name = x2
+    set_decl_name(decl)
+    insert_local_decl(fn, decl, random)
+
+
+def perm_const_var(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Hold a small constant in a typed local (`u16 one = 1;`, `s32 zero =
+    0;`), assigned at the top, just before the statement, or inside the
+    expression (`f(x, zero = 0)`). The type decides which copies agbcc
+    shares, and the assignment's position moves reload's rotation."""
+    cands: List[Tuple[ca.Constant, Block, int]] = []
+    for block, _ in all_blocks(fn):
+        for i, s in enumerate(ast_util.get_block_stmts(block, False)):
+            if isinstance(s, (ca.Decl, ca.Case, ca.Default, ca.Pragma)):
+                continue
+            # Only the statement's own expressions (not nested blocks).
+            exprs: List[ca.Node] = []
+            if isinstance(s, (ca.If, ca.While, ca.DoWhile, ca.Switch)):
+                exprs = [s.cond]
+            elif isinstance(s, ca.For):
+                exprs = [e for e in (s.init, s.cond, s.next) if e is not None]
+            elif isinstance(s, ca.Compound) or ast_util.has_nested_block(s):
+                exprs = []
+            else:
+                exprs = [s]
+
+            for e in exprs:
+                def collect(n: ca.Node) -> None:
+                    if (
+                        isinstance(n, ca.Constant)
+                        and n.type == "int"
+                        and region.contains_node(n)
+                    ):
+                        try:
+                            v = int(n.value.rstrip("uUlL"), 0)
+                        except ValueError:
+                            return
+                        if -256 <= v <= 0xFFFF:
+                            cands.append((n, block, i))
+                    return None
+
+                replace_subexprs(e, collect)
+    ensure(cands)
+    const, block, i = random.choice(cands)
+    name = new_name(fn, ast, "k")
+    tp = random.choice(INT_TYPES)
+    mode = random.randint(0, 2)
+    value = copy.deepcopy(const)
+
+    def repl(n: ca.Node) -> Optional[ca.Node]:
+        if n is const:
+            if mode == 2:
+                return ca.Assignment("=", ca.ID(name), value)
+            return ca.ID(name)
+        return None
+
+    replace_subexprs(ast_util.get_block_stmts(block, False)[i], repl)
+    if mode == 0:
+        insert_local_decl(fn, int_decl(name, tp, value), random)
+    else:
+        insert_local_decl(fn, int_decl(name, tp, None), random)
+        if mode == 1:
+            ast_util.insert_statement(block, i, ca.Assignment("=", ca.ID(name), value))
+
+
+def perm_call_order(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Pass a call's arguments through a static inline wrapper whose
+    parameters come in another order, so agbcc evaluates (and loads) them in
+    that order: `f(a, b, 0x05000002)` -> `f_2(0x05000002, a, b)` with
+    `static inline void f_2(u32 c, T a, T b) { f(a, b, c); }`. Only for
+    arguments without side effects, so the order cannot change the result."""
+    typemap = build_typemap(ast, fn)
+    from .ast_types import decayed_expr_type
+
+    cands: List[ca.FuncCall] = []
+
+    class V(ca.NodeVisitor):
+        def visit_FuncCall(self, n: ca.FuncCall) -> None:
+            if (
+                isinstance(n.name, ca.ID)
+                and n.args is not None
+                and len(n.args.exprs) >= 2
+                and region.contains_node(n)
+                and not any(ast_util.is_effectful(e) for e in n.args.exprs)
+            ):
+                cands.append(n)
+            self.generic_visit(n)
+
+    V().visit(fn.body)
+    ensure(cands)
+    call = random.choice(cands)
+    args = list(call.args.exprs)
+    n = len(args)
+    perms = [p for p in __import__("itertools").permutations(range(n)) if list(p) != list(range(n))]
+    ensure(perms)
+    order = random.choice(perms[:24])
+    try:
+        types = [decayed_expr_type(e, typemap) for e in args]
+    except Exception:
+        raise RandomizationFailure
+    callee = call.name.name
+    try:
+        ret = decayed_expr_type(call, typemap)
+    except Exception:
+        ret = ca.TypeDecl(None, [], [], ca.IdentifierType(["int"]))
+    is_void = (
+        isinstance(ret, ca.TypeDecl)
+        and isinstance(ret.type, ca.IdentifierType)
+        and ret.type.names == ["void"]
+    )
+    name = new_name(fn, ast, callee + "_")
+    params = []
+    for k, i in enumerate(order):
+        tp = copy.deepcopy(types[i])
+        inner = tp
+        while not isinstance(inner, ca.TypeDecl):
+            inner = inner.type
+        inner.declname = f"a{i}"
+        inner.quals = [q for q in (inner.quals or []) if q != "const"]
+        params.append(ca.Decl(f"a{i}", [], [], [], [], [], tp, None, None, None))
+    inner_call = ca.FuncCall(ca.ID(callee), ca.ExprList([ca.ID(f"a{i}") for i in range(n)]))
+    body = ca.Compound([inner_call if is_void else ca.Return(inner_call)])
+    rtype = copy.deepcopy(ret)
+    r_inner = rtype
+    while not isinstance(r_inner, ca.TypeDecl):
+        r_inner = r_inner.type
+    r_inner.declname = name
+    fdecl = ca.FuncDecl(ca.ParamList(params), rtype)
+    decl = ca.Decl(name, [], [], ["static"], ["inline"], [], fdecl, None, None, None)
+    helper = ca.FuncDef(decl, None, body)
+    ast.ext.insert(ast.ext.index(fn), helper)
+    call.name = ca.ID(name)
+    call.args = ca.ExprList([args[i] for i in order])
+
+
+def perm_swap_stmts(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Swap two adjacent statements that are independent: neither writes a
+    variable the other uses, at most one touches memory or calls, and neither
+    jumps. agbcc emits statements in order, so this moves loads, constants
+    and stores relative to each other without changing the program."""
+    cands: List[Tuple[Block, int]] = []
+    for block, _ in all_blocks(fn):
+        stmts = ast_util.get_block_stmts(block, False)
+        for i in range(len(stmts) - 1):
+            a, b = stmts[i], stmts[i + 1]
+            if not (region.contains_node(a) or region.contains_node(b)):
+                continue
+            if any(isinstance(x, (ca.Decl, ca.Label, ca.Case, ca.Default, ca.Pragma, ca.Return))
+                   or has_jumps(x) for x in (a, b)):
+                continue
+            wa, wb = written_names(a), written_names(b)
+            if wa & (names_in(b) | wb) or wb & names_in(a):
+                continue
+            mem_a_w, mem_b_w = touches_memory(a, writes=True), touches_memory(b, writes=True)
+            mem_a_r, mem_b_r = touches_memory(a, writes=False), touches_memory(b, writes=False)
+            if (mem_a_w and (mem_b_w or mem_b_r)) or (mem_b_w and mem_a_r):
+                continue
+            cands.append((block, i))
+    ensure(cands)
+    block, i = random.choice(cands)
+    stmts = ast_util.get_block_stmts(block, True)
+    stmts[i], stmts[i + 1] = stmts[i + 1], stmts[i]
+
+
+def _param_names(fn: ca.FuncDef) -> Set[str]:
+    assert isinstance(fn.decl.type, ca.FuncDecl)
+    args = fn.decl.type.args
+    return {q.name for q in (args.params if args else []) if isinstance(q, ca.Decl) and q.name}
+
+
+def _write_counts(fn: ca.FuncDef) -> Dict[str, int]:
+    counts: Dict[str, int] = {}
+
+    class V(ca.NodeVisitor):
+        def visit_Assignment(self, n: ca.Assignment) -> None:
+            if isinstance(n.lvalue, ca.ID):
+                counts[n.lvalue.name] = counts.get(n.lvalue.name, 0) + 1
+            self.generic_visit(n)
+
+        def visit_UnaryOp(self, n: ca.UnaryOp) -> None:
+            if n.op in ("p++", "p--", "++", "--", "&") and isinstance(n.expr, ca.ID):
+                counts[n.expr.name] = counts.get(n.expr.name, 0) + 1
+            self.generic_visit(n)
+
+    V().visit(fn.body)
+    return counts
+
+
+def perm_param_copy(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Use a parameter directly instead of a local copy of it (`T x = p;`
+    where neither is ever written again): in every use, or only in some.
+    The most common pin in the Boktai 3 depins only kept such a copy in
+    the register the original code gave the parameter itself."""
+    params = _param_names(fn)
+    writes = _write_counts(fn)
+    cands: List[Tuple[ca.Decl, str]] = []
+    for block, _ in all_blocks(fn):
+        for st in ast_util.get_block_stmts(block, False):
+            if (isinstance(st, ca.Decl) and st.name and isinstance(st.init, ca.ID)
+                    and st.init.name in params and is_scalar_decl(st)
+                    and region.contains_node(st)
+                    and writes.get(st.name, 0) == 0 and writes.get(st.init.name, 0) == 0):
+                cands.append((st, st.init.name))
+    ensure(cands)
+    decl, param = random.choice(cands)
+    uses: List[ca.ID] = [i for i in ids_in(fn.body) if i.name == decl.name]
+    ensure(uses)
+    if random_bool(random, 0.5):
+        chosen = uses
+    else:
+        k = random.randint(1, len(uses))
+        chosen = uses[-k:] if random_bool(random, 0.5) else uses[:k]
+    for i in chosen:
+        i.name = param
+    if len(chosen) == len(uses):
+        for block, _ in all_blocks(fn):
+            stmts = ast_util.get_block_stmts(block, True)
+            if decl in stmts:
+                stmts.remove(decl)
+                break
+
+
+def perm_early_return(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """`if (c) { body } [return k;]` at the end of the function becomes
+    `if (!c) return [k]; { body } [return k;]`. agbcc lays out the blocks
+    and live ranges differently; in the depins it replaced register clobber
+    hints (`asm("" ::: "rN")`) more than once."""
+    stmts = ast_util.get_block_stmts(fn.body, True)
+    cands: List[int] = []
+    for i, st in enumerate(stmts):
+        if not (isinstance(st, ca.If) and st.iffalse is None and region.contains_node(st)):
+            continue
+        tail = stmts[i + 1:]
+        if not tail or (len(tail) == 1 and isinstance(tail[0], ca.Return)
+                        and (tail[0].expr is None or isinstance(tail[0].expr, ca.Constant))):
+            cands.append(i)
+    ensure(cands)
+    i = random.choice(cands)
+    st = stmts[i]
+    tail = stmts[i + 1:]
+    value = copy.deepcopy(tail[0].expr) if tail else None
+    body = st.iftrue if isinstance(st.iftrue, ca.Compound) else ca.Compound([st.iftrue])
+    early = ca.If(ca.UnaryOp("!", st.cond), ca.Return(value), None)
+    stmts[i:i + 1] = [early, body]
+
+
+def perm_reset_const(
+    fn: ca.FuncDef, ast: ca.FileAST, indices: Indices, region: Region, random: Random
+) -> None:
+    """Assign a constant-initialised local (`u32 one = 1;`, never written
+    again) once more at the top of a loop that uses it. With two sets the
+    loop pass no longer treats it as invariant, which replaced an
+    `asm("" : "+r"(one))` barrier by hand."""
+    writes = _write_counts(fn)
+    consts: Dict[str, ca.Constant] = {}
+    for block, _ in all_blocks(fn):
+        for st in ast_util.get_block_stmts(block, False):
+            if (isinstance(st, ca.Decl) and st.name and isinstance(st.init, ca.Constant)
+                    and is_scalar_decl(st) and writes.get(st.name, 0) == 0):
+                consts[st.name] = st.init
+    ensure(consts)
+    cands: List[Tuple[ca.Node, str]] = []
+    for block, _ in all_blocks(fn):
+        for st in ast_util.get_block_stmts(block, False):
+            if isinstance(st, (ca.For, ca.While, ca.DoWhile)) and isinstance(st.stmt, ca.Compound) \
+                    and region.contains_node(st):
+                for name in names_in(st.stmt) & set(consts):
+                    cands.append((st, name))
+    ensure(cands)
+    loop, name = random.choice(cands)
+    items = loop.stmt.block_items or []
+    n = 0
+    while n < len(items) and isinstance(items[n], ca.Decl):
+        n += 1
+    items.insert(n, ca.Assignment("=", ca.ID(name), copy.deepcopy(consts[name])))
+    loop.stmt.block_items = items
+
+
+AGBCC_PASSES = [
+    perm_loop_form,
+    perm_addr_deref,
+    perm_literal_address,
+    perm_move_to_use,
+    perm_split_var,
+    perm_const_var,
+    perm_call_order,
+    perm_swap_stmts,
+    perm_param_copy,
+    perm_early_return,
+    perm_reset_const,
+]
+
+for _p in AGBCC_PASSES:
+    if _p not in RANDOMIZATION_PASSES:
+        RANDOMIZATION_PASSES.append(_p)

+def make_nodes_unique(top_node: ca.Node) -> None:
+    """Copy any node object that appears more than once below top_node.
+
+    pycparser shares one type node between the declarators of a declaration
+    like `struct T *a, *b;`. The randomizer indexes nodes by identity and
+    asserts that each appears once, so give every occurrence its own copy."""
+    seen: Set[int] = set()
+
+    def visit(node: ca.Node) -> None:
+        for attr in node.__slots__:
+            if attr in ("coord", "__weakref__"):
+                continue
+            value = getattr(node, attr, None)
+            if isinstance(value, ca.Node):
+                if id(value) in seen:
+                    value = copy.deepcopy(value)
+                    setattr(node, attr, value)
+                seen.add(id(value))
+                visit(value)
+            elif isinstance(value, list):
+                for i, item in enumerate(value):
+                    if not isinstance(item, ca.Node):
+                        continue
+                    if id(item) in seen:
+                        item = copy.deepcopy(item)
+                        value[i] = item
+                    seen.add(id(item))
+                    visit(item)
+
+    seen.add(id(top_node))
+    visit(top_node)
+
+
+def make_local_names_unique(fn: ca.FuncDef, ast: ca.FileAST) -> Dict[str, str]:
+    """Rename block-scoped locals that reuse a name already declared in the
+    function or at file scope (shadowing). Type inference keys variables by
+    name alone, so `int i` in one block and `u8 *i` in another confuse it.
+    Returns {new name: original name}."""
+    used: Set[str] = set()
+    for item in ast.ext:
+        if isinstance(item, ca.Decl) and item.name:
+            used.add(item.name)
+        elif isinstance(item, ca.FuncDef) and item.decl.name:
+            used.add(item.decl.name)
+    renamed: Dict[str, str] = {}
+    scopes: List[Dict[str, str]] = [{}]
+
+    def lookup(name: str) -> Optional[str]:
+        for scope in reversed(scopes):
+            if name in scope:
+                return scope[name]
+        return None
+
+    def declare(decl: ca.Decl) -> None:
+        name = decl.name
+        assert name is not None
+        new = name
+        counter = 1
+        while new in used:
+            counter += 1
+            new = f"{name}_{counter}"
+        used.add(new)
+        scopes[-1][name] = new
+        if new != name:
+            renamed[new] = name
+            decl.name = new
+            set_decl_name(decl)
+
+    class Visitor(ca.NodeVisitor):
+        def visit_Decl(self, node: ca.Decl) -> None:
+            if node.init is not None:
+                self.visit(node.init)
+            if node.name and not isinstance(node.type, ca.FuncDecl):
+                declare(node)
+            if node.bitsize is not None:
+                self.visit(node.bitsize)
+
+        def visit_ID(self, node: ca.ID) -> None:
+            new = lookup(node.name)
+            if new is not None:
+                node.name = new
+
+        def visit_StructRef(self, node: ca.StructRef) -> None:
+            self.visit(node.name)  # not the field name
+
+        def visit_Compound(self, node: ca.Compound) -> None:
+            scopes.append({})
+            self.generic_visit(node)
+            scopes.pop()
+
+    assert isinstance(fn.decl.type, ca.FuncDecl)
+    if fn.decl.type.args:
+        for param in fn.decl.type.args.params:
+            if isinstance(param, ca.Decl) and param.name:
+                used.add(param.name)
+                scopes[0][param.name] = param.name
+    for stmt in fn.body.block_items or []:
+        Visitor().visit(stmt)
+    return renamed
+
+
 def deduplicate_typedefs(ast: ca.FileAST) -> None:
     """Ensure multi-name typedefs sharing an anonymous struct/union/enum emit a
     single named definition instead of duplicating the body for each typedef."""

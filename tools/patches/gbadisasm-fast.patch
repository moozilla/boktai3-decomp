+/* Speed-ups (boktai3-decomp): the original looks labels up with linear scans,
+ * which is quadratic with ~100k labels. An address hash finds a label by
+ * address (addresses are unique), a bitmap of active label addresses answers
+ * next_label_addr, and a cursor skips the processed prefix of gLabels.
+ * Results are identical to the linear versions. */
+static int *sIndex;          /* open addressing: label index + 1, 0 = empty */
+static uint32_t sIndexMask;
+#define ACTIVE_SPAN 0x02000000u
+static uint64_t *sActive;    /* bit per byte address in [ROM_LOAD_ADDR, +ACTIVE_SPAN) */
+static int *sOutside;        /* labels outside that span (rare) */
+static int sOutsideCount, sOutsideCap;
+static int sScanFrom;        /* every label below this is processed or inactive */
+
+static uint32_t hash_addr(uint32_t addr)
+{
+    return (addr * 2654435761u) >> 7;
+}
+
+static void index_insert(uint32_t addr, int i)
+{
+    uint32_t h = hash_addr(addr) & sIndexMask;
+    while (sIndex[h])
+        h = (h + 1) & sIndexMask;
+    sIndex[h] = i + 1;
+}
+
+static void index_rebuild(int capacity, int n)
+{
+    int i;
+    uint32_t size = 1024;
+    while (size < (uint32_t)capacity * 2)
+        size <<= 1;
+    free(sIndex);
+    sIndex = calloc(size, sizeof(*sIndex));
+    if (sIndex == NULL)
+        fatal_error("failed to alloc label index. ");
+    sIndexMask = size - 1;
+    for (i = 0; i < n; i++)
+        index_insert(gLabels[i].addr, i);
+}
+
+static int index_find(uint32_t addr)
+{
+    uint32_t h;
+    if (sIndex == NULL)
+        return -1;
+    h = hash_addr(addr) & sIndexMask;
+    while (sIndex[h])
+    {
+        if (gLabels[sIndex[h] - 1].addr == addr)
+            return sIndex[h] - 1;
+        h = (h + 1) & sIndexMask;
+    }
+    return -1;
+}
+
+static bool in_span(uint32_t addr)
+{
+    return addr >= ROM_LOAD_ADDR && addr - ROM_LOAD_ADDR < ACTIVE_SPAN;
+}
+
+static void set_active_bit(uint32_t addr, bool on)
+{
+    uint32_t o = addr - ROM_LOAD_ADDR;
+    if (sActive == NULL)
+    {
+        sActive = calloc(ACTIVE_SPAN / 64, sizeof(*sActive));
+        if (sActive == NULL)
+            fatal_error("failed to alloc label bitmap. ");
+    }
+    if (on)
+        sActive[o >> 6] |= 1ull << (o & 63);
+    else
+        sActive[o >> 6] &= ~(1ull << (o & 63));
+}
+
+static void set_label_inactive(int i, bool inactive)
+{
+    gLabels[i].inactive = inactive;
+    if (in_span(gLabels[i].addr))
+        set_active_bit(gLabels[i].addr, !inactive);
+    if (!inactive && i < sScanFrom)
+        sScanFrom = i;
+}
+
+static void mark_unprocessed(int i)
+{
+    gLabels[i].processed = false;
+    if (i < sScanFrom)
+        sScanFrom = i;
+}
+
+/* first active label address >= addr inside the span, or 0xFFFFFFFF */
+static uint32_t next_active_in_span(uint32_t addr)
+{
+    uint32_t o, w;
+    uint64_t bits;
+    if (sActive == NULL)
+        return 0xFFFFFFFF;
+    if (addr < ROM_LOAD_ADDR)
+        addr = ROM_LOAD_ADDR;
+    if (!in_span(addr))
+        return 0xFFFFFFFF;
+    o = addr - ROM_LOAD_ADDR;
+    w = o >> 6;
+    bits = sActive[w] & (~0ull << (o & 63));
+    while (!bits)
+    {
+        if (++w >= ACTIVE_SPAN / 64)
+            return 0xFFFFFFFF;
+        bits = sActive[w];
+    }
+    return ROM_LOAD_ADDR + (w << 6) + __builtin_ctzll(bits);
+}
+

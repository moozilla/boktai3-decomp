diff --git a/include/mgba-util/socket.h b/include/mgba-util/socket.h
index 4b109ea..1907f5c 100644
--- a/include/mgba-util/socket.h
+++ b/include/mgba-util/socket.h
@@ -134,6 +134,9 @@ static inline ssize_t SocketSend(Socket socket, const void* buffer, size_t size)
 	return send(socket, (const char*) buffer, size, 0);
 #elif defined(GEKKO)
 	return net_write(socket, buffer, size);
+#elif defined(MSG_NOSIGNAL)
+	/* Boktai 3 decomp: a closed peer must not kill the emulator with SIGPIPE */
+	return send(socket, buffer, size, MSG_NOSIGNAL);
 #else
 	return write(socket, buffer, size);
 #endif
@@ -181,7 +184,15 @@ static inline Socket SocketCreate(bool useIPv6, int protocol) {
 #ifdef GEKKO
 		return net_socket(AF_INET, SOCK_STREAM, IPPROTO_IP);
 #else
-		return socket(AF_INET, SOCK_STREAM, protocol);
+		Socket s = socket(AF_INET, SOCK_STREAM, protocol);
+#ifdef SO_NOSIGPIPE
+		/* Boktai 3 decomp: no SIGPIPE when the peer goes away (macOS) */
+		if (s != INVALID_SOCKET) {
+			int one = 1;
+			setsockopt(s, SOL_SOCKET, SO_NOSIGPIPE, &one, sizeof(one));
+		}
+#endif
+		return s;
 #endif
 	}
 }
diff --git a/src/platform/headless-main.c b/src/platform/headless-main.c
index 61110b1..0d9b274 100644
--- a/src/platform/headless-main.c
+++ b/src/platform/headless-main.c
@@ -54,6 +54,12 @@ static bool _headlessCheckResiger(void);
 
 static struct mCore* core;
 
+#include <mgba/internal/gba/gba.h>
+static uint8_t _luxValue = 0xE8;
+static void _sampleLux(struct GBALuminanceSource* s) { (void) s; }
+static uint8_t _readLux(struct GBALuminanceSource* s) { (void) s; return _luxValue; }
+static struct GBALuminanceSource _headlessLux = { _sampleLux, _readLux };
+
 static bool _dispatchExiting = false;
 static int _exitCode = 0;
 static struct mStandardLogger _logger;
@@ -164,6 +170,7 @@ int main(int argc, char * argv[]) {
 	if (!mCoreLoadFile(core, args.fname)) {
 		goto loadError;
 	}
+	mCoreAutoloadSave(core); /* Boktai 3 decomp: load ROM.sav like the GUI does */
 
 #ifdef ENABLE_DEBUGGERS
 	struct mDebugger debugger;
@@ -173,11 +180,31 @@ int main(int argc, char * argv[]) {
 	if (hasDebugger) {
 		mDebuggerAttach(&debugger, core);
 		mDebuggerEnter(&debugger, DEBUGGER_ENTER_MANUAL, NULL);
+#ifdef ENABLE_SCRIPTING
+	} else if (StringListSize(&headlessOpts.scripts) && getenv("MGBA_SCRIPT_DEBUGGER")) {
+		/* Boktai 3 decomp: give scripts a debugger so emu:setBreakpoint works headless. */
+		mDebuggerAttach(&debugger, core);
+		hasDebugger = true;
+#endif
 	} else {
 		mDebuggerDeinit(&debugger);
 	}
 #endif
 
+	/* Boktai 3 decomp: a video buffer (for screenshots and scripts), and a
+	 * deterministic clock and solar sensor, as tools/emu/harness.c */
+	{
+		unsigned vw, vh;
+		core->baseVideoSize(core, &vw, &vh);
+		static mColor* videoBuffer;
+		videoBuffer = calloc(vw * vh, BYTES_PER_PIXEL);
+		core->setVideoBuffer(core, videoBuffer, vw);
+		const char* rtcEnv = getenv("BOKTAI3_RTC");
+		core->rtc.override = RTC_FIXED;
+		core->rtc.value = (int64_t) (rtcEnv ? strtoll(rtcEnv, NULL, 10) : 1128150000LL) * 1000;
+		core->setPeripheral(core, mPERIPH_GBA_LUMINANCE, &_headlessLux);
+	}
+
 	core->reset(core);
 
 	mArgumentsApplyFileLoads(&args, core);

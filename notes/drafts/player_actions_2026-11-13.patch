+    if (active && p->sceneMode == 5)
+        result = 1;
+    return result;
+}
+
+s32 Player_SelectActionSequence(struct Player *p)
+{
+    u32 mode;
+    const u16 *keys;
+    if ((gEngineFlags & 0x1000) && (u8)(p->tetherMode - 10) <= 1)
+        return p->tetherMode;

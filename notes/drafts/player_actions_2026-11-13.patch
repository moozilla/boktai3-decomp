+void sub_0815A1AC(struct Player *p, u32 kind, s32 count)
+{
+    struct PlayerColliderVector off;
+    s32 i, spawned;
+    if (!(gEngineFlags & 0x1000))
+        return;
+    if (p->movementModifierActive != 0) {
+        u8 cur = p->movementModifierKind;
+        if (cur != kind) {
+            if (cur == 3)
+                return;
+            Player_FlushQueuedEffects(p);
+        }
+    }
+    if (p->movementModifierActive == 0) {
+        u8 t = p->facingChangeEffects;
+        u8 *dst = &p->savedEffectTick;
+        u16 zero = 0;
+        *dst = t;
+        p->terrainDamageTimer = zero;
+    }
+    {
+        u16 index;
+        u32 mask;
+        u32 *indexPtr;
+        const u16 *table;
+        table = gRandomTable;
+        indexPtr = &gRandomIndex;
+        index = *indexPtr + 1;
+        mask = 0x3ff;
+        index &= mask;
+        off.x = (table[index] % 16) - 7;
+        index = (index + 1) & mask;
+        *indexPtr = index;
+        off.y = -(table[index] % 32);
+        off.z = 0;
+    }
+
+    spawned = 0;
+    for (i = 0; i < count; i++) {
+        if (EffectGroup_Spawn(&p->effectGroup, kind, 0xe10, &off) >= 0)
+            spawned = 1;
+    }
+    if (spawned) {
+        if (p->movementModifierKind == 1)
+            Sound_PlaySong(0x191);
+        else if (p->movementModifierKind == 2) {
+            p->particleEmissionCount += 10;
+            Sound_PlaySong(0x133);
+        } else if (p->movementModifierKind == 3) {
+            Sound_PlaySong(0x133);
+            p->directionFrame = 10;
+            if (p->positionResetValue == 0)
+                p->positionResetValue = 1;
+            p->contactSpecial = 0;
+        }
+    }
+    p->scriptStatus[0] = 0;
+}

+static inline u16 MaskKeys(u16 keys, u16 mask)
+{
+    return keys & mask;
+}
+
+s32 Player_GetInputDirection(struct Player *p)
+{
+    s32 keys = *p->inputKeys;
+    s16 direction = MaskKeys(keys, 0x40) != 0;
+    if (keys & 0x80)
+        direction |= 2;
+    if (keys & 0x20)
+        direction |= 4;
+    {
+        u32 m = 0x10;
+        m &= keys;
+        if (m)
+            direction |= 8;
+    }
+    return gUnk_08610B50[direction];
+}
+
+void Player_UpdateDirectionHistory(struct Player *p)
+{
+    s32 i;
+    s32 r;
+    for (i = 9; i > 0; i--)
+        p->directionHistory[i] = p->directionHistory[i - 1];
+    r = Player_GetInputDirection(p);
+    p->directionHistory[0] = r;
+    if ((s16)r >= 0) {
+        s32 t = r;
+        t += (*(s8 *)&p->catalogSavedOption);
+        p->directionHistory[0] = (t + 7) & 7;
+    }
+}
+
+void Player_StopMovementEffects(struct Player *p)
+{
+    Player_StopActionSounds(p);
+    if (p->cameraOffsetActive != 0) {
+        Player_RestoreCameraFollow(p);
+    }
+}
+
+void sub_08156C8C(struct Player *player)
+{
+    if (player->cameraOffsetActive != 0)
+        Player_RestoreCameraFollow(player);
+}
+
+void Player_EmitPeriodicParticles(struct Player *p)
+{
+    struct ContactPackedVector spread, position;
+    if (gGameState->playerParticleRate) {
+        if (gGameState->playerParticleRate <= 2499)
+            p->particleCadenceCounter++;
+        else
+            p->particleCadenceCounter += 2;
+        if (p->particleCadenceCounter > 15) {
+            if ((u8)(p->actionMode - 3) <= 1) {
+                position = *(struct ContactPackedVector *)&p->colliderPosition;
+                spread.x = 32;
+                spread.y = 32;
+                spread.z = 32;
+            } else {
+                position = *(struct ContactPackedVector *)&p->position;
+                position.y += 360;
+                spread.x = 32;
+                spread.y = 32;
+                spread.z = 32;
+            }
+            SparkParticle_Spawn(&position, 1, &spread, 0, 0, 6, 3, 2);
+            p->particleCadenceCounter = 0;
+        }
+    }
+}
+
+extern const s16 gUnk_086149C4[];
+
+static inline s32 TruncateQ12(int x)
+{
+    if (x >= 0)
+        return x >> 12;
+    return -(-x >> 12);
+}
+
+static inline s32 cellIndex(struct SceneVec *pos)
+{
+    s32 x = pos->x >> 8, z = pos->z >> 8;
+    if (x < 0 || z < 0 || (u32)x >= gTerrainWidth || (u32)z >= gTerrainHeight)
+        return 0;
+    return gTerrainMap->rows[z] + x;
+}
+
+static inline u32 ForwardGroundHeight(struct SceneVec *position)
+{
+    s32 index = cellIndex(position), height;
+    u8 *cell = TerrainModifiers_FindCellOverride(index, 1);
+    u32 kind;
+    if (cell)
+        cell += 4;
+    else
+        cell = gTerrainMap->cells + 12 + index * 4;
+    kind = *cell >> 4;
+    height = (*cell & 15) << 8;
+    switch (kind) {
+        case 1:
+            height -= (u8)position->z;
+            break;
+        case 2:
+            height -= (u8)position->x;
+            break;
+    }
+    return height;
+}
+
+// confidence=low: compares nearby terrain height and input heading before reversing facing;
+
+// Player_TryStepForward (sub_08242120) with a facing update and sequence restart at the end.
+
+#define Player_CheckFacingTerrainClearance sub_08156DAC
+
+s32 Player_CheckFacingTerrainClearance(struct Player *p)
+{
+    u32 zero = p->unk4E1[2];
+    if (zero != 0)
+        return 1;
+    {
+        u8 axis = p->coordinateAxis;
+        u32 a = (axis + 7) & 7;
+        u32 b = (axis + 9) & 7;
+        s32 h = (s16)p->directionHistory[0];
+        if (h == axis || h == a || h == b) {
+            struct PlayerColliderVector pt;
+            u32 ang = ((p->coordinateAxis + 1) & 7) << 5;
+            u32 height;
+            pt = *(struct PlayerColliderVector *)&p->position;
+            pt.x += -TruncateQ12(gUnk_086149C4[(ang + 0x40) & 0xff] * 0x32);
+            pt.z += -TruncateQ12(gUnk_086149C4[ang] * 0x32);
+            height = ForwardGroundHeight((struct SceneVec *)&pt);
+            if (height >= (u32)(p->position.y + 0xc8))
+                return 1;
+            p->facing = (p->coordinateAxis + 4) & 7;
+        } else {
+            p->facing = (axis + 4) & 7;
+        }
+    }
+    Player_UpdateFacingSide(p);
+    ActorSequence_Begin(p, 0, 0);
+    return 0;
+}
+
+static inline u32 TetherAcceptsActionInput(void)
+{
+    if (!gTetherActor)
+        return 0;
+    switch (gTetherActor->state) {
+        case 1:
+        case 0x11:
+            return 1;
+    }
+    return 0;
+}
+
+s32 Player_TestTetherActionInput(struct Player *p)
+{
+    if (*p->inputKeys & 1) {
+        if (!TetherAcceptsActionInput())
+            return 0;
+        if (TetherActor_TestMatchingStatus(p->tetherStatusTag, p->tetherStatusFlags,
+                                           gTetherActor->statusTag, gTetherActor->statusFlags))
+            return 1;
+    }
+    return 0;
+}

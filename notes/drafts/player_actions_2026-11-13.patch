+static inline u32 HasActionFlag(struct Player *p, u32 mask)
+{
+    if (!p)
+        return 0;
+    {
+        u32 *flags = &p->actionFlags;
+        u32 bits = mask;
+        return *flags & bits;
+    }
+}
